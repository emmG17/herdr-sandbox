#!/usr/bin/env python3
"""Setup and readiness checks for the Herdr sandbox plugin."""

import argparse
import json
import os
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys
import tomllib
from datetime import datetime, timezone
from uuid import uuid4


PLUGIN_ID = "dev.herdr.sandbox"
WORKER_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")
LIFECYCLE_STATES = {"created", "running", "stopped", "completed", "failed"}
DEFAULT_CONFIG = (Path(__file__).resolve().parent.parent / "config.example.toml").read_text()


def paths():
    config = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    state = os.environ.get("HERDR_PLUGIN_STATE_DIR")
    if not config or not state:
        raise ValueError("Herdr plugin paths are missing. Run this through `herdr plugin action invoke` or set HERDR_PLUGIN_CONFIG_DIR and HERDR_PLUGIN_STATE_DIR.")
    return Path(config), Path(state)


def load_config(config_dir):
    config_file = config_dir / "config.toml"
    if not config_file.is_file():
        raise ValueError(f"Missing {config_file}. Run `herdr plugin action invoke setup --plugin {PLUGIN_ID}`.")
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    runtime = config.get("runtime")
    codex = config.get("codex")
    if not isinstance(runtime, dict) or not isinstance(codex, dict):
        raise ValueError(f"Expected [runtime] and [codex] tables in {config_file}.")
    image = runtime.get("image")
    home = codex.get("home")
    if not isinstance(image, str) or not image.strip():
        raise ValueError(f"Set a nonempty [runtime].image in {config_file}.")
    if not isinstance(home, str) or home in ("", ".") or Path(home).is_absolute() or ".." in Path(home).parts:
        raise ValueError(f"Set [codex].home to a relative path inside {config_dir}.")
    codex_home = (config_dir / home).resolve()
    if codex_home == config_dir.resolve() or not codex_home.is_relative_to(config_dir.resolve()):
        raise ValueError(f"Codex home escapes plugin config directory: {codex_home}.")
    if codex_home == (Path.home() / ".codex").resolve():
        raise ValueError("The normal user Codex home cannot be used by this plugin.")
    return image, codex_home


def runtime_settings(config_dir):
    """Load the fixed Podman settings shared by every worker entrypoint."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    runtime = config.get("runtime")
    resources = config.get("resources")
    if not isinstance(runtime, dict) or not isinstance(resources, dict):
        raise ValueError(f"Expected [runtime] and [resources] tables in {config_file}.")
    network = runtime.get("network")
    cpus, memory, pids = resources.get("cpus"), resources.get("memory"), resources.get("pids")
    if network not in {"online", "offline"}:
        raise ValueError(f"Set [runtime].network to 'online' or 'offline' in {config_file}.")
    if not isinstance(cpus, (int, float)) or isinstance(cpus, bool) or cpus <= 0:
        raise ValueError(f"Set [resources].cpus to a positive number in {config_file}.")
    if not isinstance(memory, str) or not re.fullmatch(r"[1-9][0-9]*(?:[kKmMgGtT][iI]?[bB]?|[bB])?", memory):
        raise ValueError(f"Set [resources].memory to a positive Podman memory value in {config_file}.")
    if not isinstance(pids, int) or isinstance(pids, bool) or pids <= 0:
        raise ValueError(f"Set [resources].pids to a positive integer in {config_file}.")
    return network, cpus, memory, pids


def run(*argv):
    return subprocess.run(argv, capture_output=True, text=True, check=False)


def host_errors():
    errors = []
    if platform.system() != "Linux":
        errors.append("Linux is required for the rootless Podman worker.")
    if shutil.which("git") is None:
        errors.append("Git is missing. Install git and retry.")
    if shutil.which("podman") is None:
        errors.append("Podman is missing. Install and configure rootless Podman.")
    elif platform.system() == "Linux":
        result = run("podman", "info", "--format", "{{.Host.Security.Rootless}}")
        if result.returncode != 0:
            errors.append(f"Podman is unavailable: {result.stderr.strip() or result.stdout.strip()}. Fix rootless Podman and retry.")
        elif result.stdout.strip().lower() != "true":
            errors.append("Podman is running as root. Configure rootless Podman and retry.")
    return errors


def check_source(repo):
    source = Path(repo).expanduser().resolve()
    if not source.is_dir():
        return f"Source repository does not exist: {source}."
    result = run("git", "-C", str(source), "rev-parse", "--show-toplevel")
    if result.returncode != 0 or Path(result.stdout.strip()).resolve() != source:
        return f"Source must be the root of a Git repository: {source}."
    return None


def context_repo():
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if not raw:
        return None
    try:
        context = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError(f"Invalid HERDR_PLUGIN_CONTEXT_JSON: {exc}.") from exc
    if not isinstance(context, dict):
        raise ValueError("HERDR_PLUGIN_CONTEXT_JSON must be an object.")
    repo = context.get("workspace_cwd")
    if repo is not None and not isinstance(repo, str):
        raise ValueError("Herdr workspace path must be a string.")
    return repo


def check(repo=None, require_auth=False):
    errors = host_errors()
    try:
        config_dir, state_dir = paths()
        if not config_dir.is_dir():
            errors.append(f"Plugin config directory is missing: {config_dir}. Run the setup action.")
        if not state_dir.is_dir():
            errors.append(f"Plugin state directory is missing: {state_dir}. Run the setup action.")
        image, codex_home = load_config(config_dir)
        if not codex_home.is_dir():
            errors.append(f"Dedicated Codex home is missing: {codex_home}. Run the setup action.")
        elif require_auth and not (codex_home / "auth.json").is_file():
            errors.append(f"Codex authentication is missing in {codex_home}. Run `CODEX_HOME={codex_home} codex login --device-auth`.")
        if shutil.which("podman") and platform.system() == "Linux":
            result = run("podman", "image", "exists", image)
            if result.returncode != 0:
                errors.append(f"Worker image {image} is missing. Run `herdr plugin action invoke build-image --plugin {PLUGIN_ID}`.")
    except (ValueError, OSError, tomllib.TOMLDecodeError) as exc:
        errors.append(str(exc))
    if repo is not None and shutil.which("git"):
        source_error = check_source(repo)
        if source_error:
            errors.append(source_error)
    return errors


def setup():
    config_dir, state_dir = paths()
    config_dir.mkdir(parents=True, exist_ok=True)
    state_dir.mkdir(parents=True, exist_ok=True)
    config_file = config_dir / "config.toml"
    if not config_file.exists():
        config_file.write_text(DEFAULT_CONFIG)
    image, codex_home = load_config(config_dir)
    codex_home.mkdir(parents=True, exist_ok=True)
    codex_home.chmod(0o700)
    print(f"Config: {config_file}\nState: {state_dir}\nCodex home: {codex_home}\nImage: {image}")
    print(f"Next: `herdr plugin action invoke build-image --plugin {PLUGIN_ID}`")
    print(f"Authenticate: `CODEX_HOME={codex_home} codex login --device-auth`")


def build_image():
    errors = host_errors()
    if errors:
        raise ValueError("\n".join(errors))
    config_dir, _ = paths()
    image, _ = load_config(config_dir)
    root = Path(os.environ.get("HERDR_PLUGIN_ROOT", Path(__file__).resolve().parent.parent))
    result = subprocess.run(["podman", "build", "--tag", image, "--file", str(root / "Containerfile"), str(root)], check=False)
    if result.returncode:
        raise ValueError(f"Image build failed with exit code {result.returncode}.")
    print(f"Built {image}")


def git(*args):
    result = run("git", *map(str, args))
    if result.returncode:
        raise ValueError(result.stderr.strip() or result.stdout.strip() or "Git command failed.")
    return result.stdout.strip()


def validate_worker_id(worker_id):
    """Validate an ID before it is used as a worker path or container name."""
    if not isinstance(worker_id, str) or not WORKER_ID_RE.fullmatch(worker_id) or ".." in worker_id:
        raise ValueError("Worker ID must contain letters, digits, dots, underscores, or hyphens, start with a letter or digit, and contain no '..'.")
    return worker_id


def state_workers_dir(state_dir=None):
    """Return the plugin-owned worker directory without requiring setup config."""
    if state_dir is None:
        _, state_dir = paths()
    return Path(state_dir).expanduser().resolve() / "workers"


def worker_dir_for(worker_id, state_dir=None):
    validate_worker_id(worker_id)
    return state_workers_dir(state_dir) / worker_id


def worker_storage(worker_id, state_dir=None):
    """Resolve a worker path without following an escape through worker state."""
    workers_dir = state_workers_dir(state_dir)
    state_root = workers_dir.parent
    if state_root.exists() and not state_root.is_dir():
        raise ValueError(f"Plugin state path is not a directory: {state_root}.")
    if workers_dir.is_symlink() or (workers_dir.exists() and not workers_dir.is_dir()):
        raise ValueError(f"Worker state directory is not a real directory: {workers_dir}")

    worker_dir = worker_dir_for(worker_id, state_dir)
    if worker_dir.is_symlink():
        raise ValueError(f"Worker path is not a real directory inside plugin workers: {worker_dir}")
    if not worker_dir.resolve().is_relative_to(workers_dir.resolve()):
        raise ValueError(f"Worker path escapes plugin workers directory: {worker_dir}")
    if worker_dir.exists() and not worker_dir.is_dir():
        raise ValueError(f"Worker path is not a directory: {worker_dir}")
    return workers_dir, worker_dir


def _container_missing(result):
    detail = f"{result.stderr}\n{result.stdout}".lower()
    return (
        "no such container" in detail
        or "no container with name or id" in detail
        or bool(re.search(r"container[^\n]*(?:does not exist|not found)", detail))
    )


def remove_worker_container(worker_id):
    """Force-remove a worker container, tolerating an already absent container."""
    validate_worker_id(worker_id)
    result = run("podman", "rm", "-f", f"herdr-{worker_id}")
    if result.returncode and not _container_missing(result):
        detail = result.stderr.strip() or result.stdout.strip() or "unknown Podman error"
        raise ValueError(f"Unable to remove worker container herdr-{worker_id}: {detail}.")


def destroy_worker(worker_id, state_dir=None):
    """Stop/remove a worker container, then remove only that worker's storage."""
    _, worker_dir = worker_storage(worker_id, state_dir)
    remove_worker_container(worker_id)
    if not worker_dir.exists():
        return False
    shutil.rmtree(worker_dir)
    return True


def fetch_options(config_dir):
    """Read the fixed worker ID used by the non-prompting fetch action."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("fetch", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [fetch] table in {config_file}.")
    if "id" in options and not isinstance(options["id"], str):
        raise ValueError(f"Set [fetch].id to a string in {config_file}.")
    return options


def fetch_worker(worker_id, state_dir=None):
    """Fetch a worker branch into its source repository for later review."""
    _, worker_dir = worker_storage(worker_id, state_dir)
    repo = worker_dir / "repo"
    metadata_path = worker_dir / "worker.json"
    if not repo.is_dir() or repo.is_symlink():
        raise ValueError(f"Worker repository is missing: {repo}")
    try:
        with metadata_path.open() as stream:
            metadata = json.load(stream)
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Invalid worker metadata: {metadata_path}") from exc
    if not isinstance(metadata, dict) or not isinstance(metadata.get("source_repo"), str):
        raise ValueError(f"Invalid worker metadata: {metadata_path}")
    source = Path(metadata["source_repo"]).expanduser().resolve()
    source_error = check_source(source)
    if source_error:
        raise ValueError(source_error)
    source = Path(git("-C", source, "rev-parse", "--show-toplevel")).resolve()
    branch = f"agent/{validate_worker_id(worker_id)}"
    base_commit = metadata.get("base_commit")
    if not isinstance(base_commit, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", base_commit):
        raise ValueError(f"Worker metadata has no valid base commit: {metadata_path}")

    git("-C", source, "fetch", "--no-tags", "--", repo, f"refs/heads/{branch}")
    commit = git("-C", source, "rev-parse", "--verify", "FETCH_HEAD^{commit}")
    changed_files = [name for name in git("-C", source, "diff", "--no-ext-diff", "--name-only", f"{base_commit}...FETCH_HEAD").splitlines() if name]
    diff_stat = git("-C", source, "diff", "--no-ext-diff", "--stat", f"{base_commit}...FETCH_HEAD")
    return {"commit": commit, "changed_files": changed_files, "diff_stat": diff_stat}


def format_fetch_result(result):
    """Format the fetched commit and review summary without implying integration."""
    files = "\n".join(result["changed_files"]) or "(none)"
    stat = result["diff_stat"] or "(no changes)"
    return f"Commit: {result['commit']}\nChanged files:\n{files}\nDiff stat:\n{stat}"


def cherry_pick_options(config_dir):
    """Read the fixed worker and reviewed commit used by the Herdr action."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("cherry_pick", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [cherry_pick] table in {config_file}.")
    for name in ("id", "commit"):
        if name in options and not isinstance(options[name], str):
            raise ValueError(f"Set [cherry_pick].{name} to a string in {config_file}.")
    return options


def cherry_pick_worker(worker_id, commit, state_dir=None):
    """Deliberately cherry-pick one reviewed worker commit into its source repo."""
    validate_worker_id(worker_id)
    if not isinstance(commit, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", commit):
        raise ValueError("Commit must be the full 40-character SHA reported by fetch.")

    _, worker_dir = worker_storage(worker_id, state_dir)
    repo = worker_dir / "repo"
    metadata_path = worker_dir / "worker.json"
    if not repo.is_dir() or repo.is_symlink():
        raise ValueError(f"Worker repository is missing: {repo}")
    try:
        with metadata_path.open() as stream:
            metadata = json.load(stream)
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Invalid worker metadata: {metadata_path}") from exc
    if not isinstance(metadata, dict) or not isinstance(metadata.get("source_repo"), str):
        raise ValueError(f"Invalid worker metadata: {metadata_path}")
    base_commit = metadata.get("base_commit")
    if not isinstance(base_commit, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", base_commit):
        raise ValueError(f"Worker metadata has no valid base commit: {metadata_path}")

    source = Path(metadata["source_repo"]).expanduser().resolve()
    source_error = check_source(source)
    if source_error:
        raise ValueError(source_error)
    source = Path(git("-C", source, "rev-parse", "--show-toplevel")).resolve()
    fetched = run("git", "-C", str(source), "rev-parse", "--verify", "FETCH_HEAD^{commit}")
    if fetched.returncode:
        raise ValueError(f"No fetched worker commit is available in {source}. Run fetch for {worker_id}, review it, then retry.")
    in_range = run("git", "-C", str(source), "merge-base", "--is-ancestor", commit, "FETCH_HEAD")
    branch = f"refs/heads/agent/{worker_id}"
    in_worker_branch = run("git", "-C", str(repo), "merge-base", "--is-ancestor", commit, branch)
    after_base = run("git", "-C", str(repo), "merge-base", "--is-ancestor", base_commit, commit)
    if in_range.returncode or in_worker_branch.returncode or after_base.returncode or commit.lower() == base_commit.lower():
        raise ValueError(f"Commit {commit} is not a reviewed change from worker {worker_id}. Fetch and review that worker before cherry-picking.")
    if git("-C", source, "status", "--porcelain"):
        raise ValueError(f"Source repository has uncommitted changes: {source}. Commit or stash them before cherry-picking.")

    result = run("git", "-C", str(source), "cherry-pick", "--no-edit", commit)
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "Git cherry-pick failed."
        raise ValueError(
            f"Cherry-pick failed for {commit}: {detail}\n"
            f"Resolve conflicts in {source}, then run `git -C {source} cherry-pick --continue`; "
            f"or run `git -C {source} cherry-pick --abort` to recover."
        )
    integrated_commit = git("-C", source, "rev-parse", "HEAD")
    return {"commit": commit, "integrated_commit": integrated_commit, "source": str(source)}


def format_cherry_pick_result(result):
    """Format a completed explicit integration without implying future actions."""
    return f"Cherry-picked: {result['commit']}\nIntegrated commit: {result['integrated_commit']}\nSource: {result['source']}"


def open_options(config_dir):
    """Read the fixed worker chosen by the non-prompting Herdr open action."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("open", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected an [open] table in {config_file}.")
    if "id" in options and not isinstance(options["id"], str):
        raise ValueError(f"Set [open].id to a string in {config_file}.")
    return options


def execute_options(config_dir):
    """Read the fixed inputs used by the non-prompting Herdr execute action."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("execute", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected an [execute] table in {config_file}.")
    for key in ("id", "prompt"):
        if key in options and not isinstance(options[key], str):
            raise ValueError(f"Set [execute].{key} to a string in {config_file}.")
    return options


def _write_worker_status(worker_dir, status):
    metadata_path = worker_dir / "worker.json"
    with metadata_path.open() as stream:
        metadata = json.load(stream)
    if not isinstance(metadata, dict):
        raise ValueError(f"Invalid worker metadata: {metadata_path}")
    metadata["status"] = status
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")


class PodmanSandboxRuntime:
    """The single owner of the Podman worker isolation contract."""

    def __init__(self, worker_id, image, repo, codex_home, network, cpus, memory, pids):
        self.worker_id = worker_id
        self.image = image
        self.repo = repo
        self.codex_home = codex_home
        self.network = network
        self.cpus = cpus
        self.memory = memory
        self.pids = pids

    def _base_command(self, interactive=False):
        """Build the shared hardened Podman invocation for both execution modes."""
        invocation = [
            "podman", "run", "--rm",
            "--userns=keep-id", "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
            f"--pids-limit={self.pids}", f"--memory={self.memory}", f"--cpus={self.cpus}",
            "--env", "HOME=/tmp/home", "--env", "CODEX_HOME=/codex", "--env", "XDG_CACHE_HOME=/tmp/cache",
            "--mount", f"type=bind,src={self.repo.resolve()},dst=/workspace,rw",
            "--mount", f"type=bind,src={self.codex_home.resolve()},dst=/codex,rw",
            "--workdir", "/workspace",
        ]
        if interactive:
            invocation.insert(3, "-it")
        invocation.insert(4 if interactive else 3, "--name")
        invocation.insert(5 if interactive else 4, f"herdr-{self.worker_id}")
        if self.network == "offline":
            invocation.append("--network=none")
        return invocation

    def interactive_command(self, command=None):
        args = list(command or ["bash"])
        if not args or any(not isinstance(arg, str) or not arg for arg in args):
            raise ValueError("Interactive command must contain nonempty arguments.")
        return self._base_command(interactive=True) + [self.image] + args

    def noninteractive_command(self, prompt):
        if not isinstance(prompt, str) or not prompt.strip():
            raise ValueError("Execution prompt must be a nonempty string.")
        return self._base_command() + [self.image, "codex", "exec", "--sandbox", "danger-full-access", prompt]


def podman_runtime(worker_id):
    """Create the configured runtime only after validating its permitted paths."""
    validate_worker_id(worker_id)
    config_dir, state_dir = paths()
    image, codex_home = load_config(config_dir)
    network, cpus, memory, pids = runtime_settings(config_dir)
    _, worker_dir = worker_storage(worker_id, state_dir)
    repo = worker_dir / "repo"
    if not repo.is_dir() or repo.is_symlink() or not (repo / ".git").exists():
        raise ValueError(f"Worker repository does not exist: {repo}")
    if not codex_home.is_dir() or codex_home.is_symlink():
        raise ValueError(f"Dedicated Codex home does not exist: {codex_home}")
    return PodmanSandboxRuntime(worker_id, image, repo, codex_home, network, cpus, memory, pids)


def open_command(worker_id, command=None):
    """Build the central runtime's interactive invocation for a worker."""
    return podman_runtime(worker_id).interactive_command(command)


def execute_command(worker_id, prompt):
    """Build the shared runtime's noninteractive Codex invocation for a worker."""
    return podman_runtime(worker_id).noninteractive_command(prompt)


def open_worker(worker_id, command=None):
    """Open a terminal-attached worker session for Herdr to manage."""
    config_dir, state_dir = paths()
    _, worker_dir = worker_storage(worker_id, state_dir)
    command = list(command or ["bash"])
    errors = check(require_auth=command[0] == "codex")
    if errors:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
    invocation = open_command(worker_id, command)
    _write_worker_status(worker_dir, "running")
    try:
        result = subprocess.run(invocation, check=False)
    except BaseException:
        _write_worker_status(worker_dir, "failed")
        raise
    _write_worker_status(worker_dir, "stopped" if result.returncode == 0 else "failed")
    return result.returncode


def execute_worker(worker_id, prompt):
    """Run one Codex prompt without a TTY or open stdin, preserving worker edits."""
    _, state_dir = paths()
    _, worker_dir = worker_storage(worker_id, state_dir)
    errors = check(require_auth=True)
    if errors:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
    invocation = execute_command(worker_id, prompt)
    _write_worker_status(worker_dir, "running")
    try:
        result = subprocess.run(
            invocation, stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False,
        )
    except BaseException:
        _write_worker_status(worker_dir, "failed")
        raise
    _write_worker_status(worker_dir, "completed" if result.returncode == 0 else "failed")
    repo = worker_dir / "repo"
    head_code, head, _ = _git_read(repo, "rev-parse", "HEAD")
    status_code, git_status, _ = _git_read(repo, "status", "--short")
    return {
        "worker_id": worker_id,
        "exit_status": result.returncode,
        "head": head if head_code == 0 else "unavailable",
        "git_status": git_status if status_code == 0 else "unavailable",
        "dirty": bool(git_status) if status_code == 0 else None,
        "output_location": "Herdr action output (stdout/stderr)",
        "stdout": result.stdout,
        "stderr": result.stderr,
    }


def print_execution_result(result):
    """Print captured Codex output followed by an actionable worker summary."""
    if result["stdout"]:
        print(result["stdout"], end="")
    if result["stderr"]:
        print(result["stderr"], end="", file=sys.stderr)
    print(
        f"Worker: {result['worker_id']}\n"
        f"Exit status: {result['exit_status']}\n"
        f"HEAD: {result['head']}\n"
        f"Dirty: {result['dirty']}\n"
        f"Git status: {result['git_status'] or 'clean'}\n"
        f"Codex output: {result['output_location']}"
    )


def _metadata_value(metadata, key, default="-"):
    value = metadata.get(key, default)
    return value if isinstance(value, str) and value else default


def _git_read(repo, *args):
    """Read Git output without turning missing/stale worker state into a crash."""
    result = run("git", "-C", str(repo), *map(str, args))
    output = (result.stdout or "").strip()
    error = (result.stderr or "").strip()
    return result.returncode, output, error


def container_status(worker_id):
    """Return Podman reality for a worker's conventional container name."""
    try:
        validate_worker_id(worker_id)
    except ValueError:
        return "invalid-id"
    if shutil.which("podman") is None:
        return "unavailable"
    result = run("podman", "inspect", "--format", "{{.State.Status}}", f"herdr-{worker_id}")
    if result.returncode:
        detail = (result.stderr or result.stdout or "podman inspect failed").strip()
        lowered = detail.lower()
        if any(marker in lowered for marker in ("no such object", "no such container", "does not exist", "not found")):
            return "not-found"
        return f"error: {detail}"
    status = (result.stdout or "").strip().lower()
    return status or "present"


def _base_commit(repo, metadata):
    """Resolve the persisted base safely for the ordinary three-dot diff."""
    candidate = metadata.get("base_commit")
    if isinstance(candidate, str) and re.fullmatch(r"[0-9a-fA-F]{40}", candidate):
        return candidate
    base_ref = metadata.get("base_ref")
    if not isinstance(base_ref, str) or not base_ref or base_ref.startswith("-") or any(char.isspace() for char in base_ref):
        return None
    code, output, _ = _git_read(repo, "rev-parse", "--verify", "--end-of-options", f"{base_ref}^{{commit}}")
    return output if code == 0 else None


def _git_reality(repo, metadata):
    reality = {
        "head": None,
        "branch": None,
        "dirty": None,
        "git_log": "",
        "git_status": "",
        "git_diff": "",
        "base_commit": _metadata_value(metadata, "base_commit"),
        "issues": [],
    }
    if repo.is_symlink() or not repo.is_dir():
        reality["issues"].append(f"Worker repository is missing: {repo}")
        return reality
    git_dir = repo / ".git"
    if not git_dir.exists():
        reality["issues"].append(f"Worker repository is not a Git repository: {repo}")
        return reality

    code, output, error = _git_read(repo, "rev-parse", "HEAD")
    if code:
        reality["issues"].append(f"Unable to read worker HEAD: {error or 'Git failed'}")
    else:
        reality["head"] = output

    code, output, error = _git_read(repo, "branch", "--show-current")
    if code:
        reality["issues"].append(f"Unable to read worker branch: {error or 'Git failed'}")
    else:
        reality["branch"] = output or "(detached)"

    code, output, error = _git_read(repo, "status", "--porcelain", "--untracked-files=all")
    if code:
        reality["issues"].append(f"Unable to read worker status: {error or 'Git failed'}")
    else:
        reality["dirty"] = bool(output)

    code, output, error = _git_read(repo, "log", "--oneline", "--decorate", "-n", "20")
    reality["git_log"] = output if not code else f"(unavailable: {error or 'Git failed'})"
    code, output, error = _git_read(repo, "status", "--short", "--branch")
    reality["git_status"] = output if not code else f"(unavailable: {error or 'Git failed'})"

    base_commit = _base_commit(repo, metadata)
    if base_commit:
        reality["base_commit"] = base_commit
        code, output, error = _git_read(repo, "diff", "--no-ext-diff", f"{base_commit}...HEAD")
        reality["git_diff"] = output if not code else f"(unavailable: {error or 'Git failed'})"
    else:
        reality["git_diff"] = "(unavailable: persisted base ref cannot be resolved)"
        reality["issues"].append("Persisted base ref cannot be resolved in the worker repository")
    return reality


def _worker_record(worker_dir):
    """Build a recoverable view by combining worker.json and live reality."""
    worker_id = worker_dir.name
    record = {
        "id": worker_id,
        "worker_dir": str(worker_dir),
        "repository": str(worker_dir / "repo"),
        "source_repo": "-",
        "base_ref": "-",
        "branch": "-",
        "metadata_branch": "-",
        "created_at": "-",
        "runtime": "-",
        "network": "-",
        "metadata_status": "unknown",
        "status": "invalid",
        "container": "not-checked",
        "head": None,
        "dirty": None,
        "git_log": "",
        "git_status": "",
        "git_diff": "",
        "issues": [],
    }
    if worker_dir.is_symlink() or not worker_dir.is_dir():
        record["issues"].append("Worker state entry is not a real directory")
        return record

    metadata_path = worker_dir / "worker.json"
    metadata = {}
    if not metadata_path.is_file():
        record["issues"].append(f"Missing worker metadata: {metadata_path}")
    else:
        try:
            with metadata_path.open() as stream:
                metadata = json.load(stream)
            if not isinstance(metadata, dict):
                raise ValueError("metadata must be a JSON object")
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            record["issues"].append(f"Invalid worker metadata {metadata_path}: {exc}")
            metadata = {}

    record["source_repo"] = _metadata_value(metadata, "source_repo")
    record["base_ref"] = _metadata_value(metadata, "base_ref")
    record["branch"] = _metadata_value(metadata, "branch")
    record["metadata_branch"] = record["branch"]
    record["created_at"] = _metadata_value(metadata, "created_at")
    record["runtime"] = _metadata_value(metadata, "runtime")
    record["network"] = _metadata_value(metadata, "network")
    record["metadata_status"] = _metadata_value(metadata, "status", "unknown")
    if record["metadata_status"] not in LIFECYCLE_STATES and record["metadata_status"] != "unknown":
        record["issues"].append(f"Unknown persisted lifecycle status: {record['metadata_status']}")
    if metadata and metadata.get("id") != worker_id:
        record["issues"].append(f"Metadata ID does not match state directory ({metadata.get('id', '-')})")

    source = Path(record["source_repo"]).expanduser() if record["source_repo"] != "-" else None
    if source is not None and not source.is_dir():
        record["issues"].append(f"Source repository is missing: {source}")

    reality = _git_reality(worker_dir / "repo", metadata)
    record.update({key: reality[key] for key in ("head", "dirty", "git_log", "git_status", "git_diff")})
    record["issues"].extend(reality["issues"])
    if reality["branch"]:
        actual_branch = reality["branch"]
        if record["metadata_branch"] != "-" and record["metadata_branch"] != actual_branch:
            record["issues"].append(f"Branch differs from metadata ({record['metadata_branch']} vs {actual_branch})")
        record["branch"] = actual_branch
        record["actual_branch"] = actual_branch
    else:
        record["actual_branch"] = None

    record["container"] = container_status(worker_id)
    if record["container"] == "unavailable":
        record["issues"].append("Podman is unavailable; container state could not be checked")
    elif record["container"].startswith("error:"):
        record["issues"].append(f"Unable to inspect worker container: {record['container'][len('error: '):]}")
    if record["container"] == "running":
        record["status"] = "running"
    elif record["metadata_status"] == "running" and record["container"] == "not-found":
        record["status"] = "stale"
        record["issues"].append("Metadata says running but no corresponding container exists")
    elif record["metadata_status"] == "running" and (record["container"] == "unavailable" or record["container"].startswith("error:")):
        record["status"] = "unknown"
        record["issues"].append("Persisted lifecycle says running, but live container state is unavailable")
    elif record["container"] in {"exited", "stopped", "created", "paused", "unknown"} and record["metadata_status"] == "running":
        record["status"] = "stopped"
    elif record["metadata_status"] in LIFECYCLE_STATES:
        record["status"] = record["metadata_status"]
    else:
        record["status"] = "invalid" if record["issues"] else "unknown"
    if any(issue.startswith("Worker repository") for issue in record["issues"]):
        record["status"] = "missing-repo"
    if metadata and not record["issues"] and record["status"] == "invalid":
        record["status"] = "unknown"
    return record


def list_workers(state_dir=None):
    """List persisted workers, including entries whose state has gone stale."""
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.exists():
        return []
    if workers_dir.is_symlink() or not workers_dir.is_dir():
        raise ValueError(f"Worker state directory is not a real directory: {workers_dir}")
    return [_worker_record(entry) for entry in sorted(workers_dir.iterdir(), key=lambda path: path.name) if entry.name not in {".", ".."}]


def inspect_worker(worker_id, state_dir=None):
    """Inspect one worker and expose ordinary Git commands and output."""
    worker_dir = worker_dir_for(worker_id, state_dir)
    if not worker_dir.exists() or worker_dir.is_symlink():
        raise ValueError(f"Worker not found: {worker_id}")
    return _worker_record(worker_dir)


def _display(value, missing="-"):
    if value is None:
        return missing
    if isinstance(value, bool):
        return "yes" if value else "no"
    return str(value)


def format_workers(records):
    columns = ("ID", "REPOSITORY", "BASE", "BRANCH", "STATUS", "CREATED", "HEAD", "DIRTY", "CONTAINER")
    rows = [columns]
    for record in records:
        rows.append((
            record["id"], record["repository"], record["base_ref"], record["branch"], record["status"],
            record["created_at"], (record["head"] or "-")[:12], _display(record["dirty"]), record["container"],
        ))
    if len(rows) == 1:
        return "No sandbox workers found."
    widths = [max(len(str(row[index])) for row in rows) for index in range(len(columns))]
    return "\n".join("  ".join(str(value).ljust(widths[index]) for index, value in enumerate(row)).rstrip() for row in rows)


def format_worker(record):
    lines = [
        f"Worker: {record['id']}",
        f"Repository: {record['repository']}",
        f"Source: {record['source_repo']}",
        f"Base: {record['base_ref']}",
        f"Branch: {record['branch']}",
        f"Runtime: {record['runtime']}",
        f"Network: {record['network']}",
        f"Container: {record['container']}",
        f"Status: {record['status']}",
        f"Created: {record['created_at']}",
        f"HEAD: {record['head'] or '-'}",
        f"Dirty: {_display(record['dirty'])}",
    ]
    if record["issues"]:
        lines.extend(["Issues:"] + [f"- {issue}" for issue in record["issues"]])
    lines.extend([
        "",
        "Git log:",
        record["git_log"] or "(no commits)",
        "",
        "Git status:",
        record["git_status"] or "(clean)",
        "",
        f"Git diff {record['base_ref']}...HEAD:",
        record["git_diff"] or "(no changes)",
    ])
    return "\n".join(lines)


def create_options(config_dir):
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("create", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [create] table in {config_file}.")
    for key in ("id", "source_repo", "base_ref"):
        if key in options and not isinstance(options[key], str):
            raise ValueError(f"Set [create].{key} to a string in {config_file}.")
    return options


def destroy_options(config_dir):
    """Read the optional worker ID used by the noninteractive destroy action."""
    config_file = config_dir / "config.toml"
    if not config_file.is_file():
        return {}
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("destroy", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [destroy] table in {config_file}.")
    if "id" in options and not isinstance(options["id"], str):
        raise ValueError(f"Set [destroy].id to a string in {config_file}.")
    return options


def create_worker(worker_id, repo=None, base_ref="HEAD"):
    validate_worker_id(worker_id)
    branch = f"agent/{worker_id}"
    git("check-ref-format", "--branch", branch)
    if not base_ref or base_ref.startswith("-") or any(char.isspace() for char in base_ref):
        raise ValueError("Base ref must be a nonempty Git ref or commit without whitespace or a leading hyphen.")
    repo = repo or context_repo()
    if not repo:
        raise ValueError("Source repository is missing. Pass --repo or invoke from a Herdr Git workspace.")
    source = Path(repo).expanduser().resolve()
    if not source.is_dir():
        raise ValueError(f"Source repository does not exist: {source}.")
    source_root = Path(git("-C", source, "rev-parse", "--show-toplevel")).resolve()
    if source_root != source:
        source = source_root
    commit = git("-C", source, "rev-parse", "--verify", "--end-of-options", f"{base_ref}^{{commit}}")
    errors = check(str(source))
    if errors:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
    _, state_dir = paths()
    if not state_dir.is_dir():
        raise ValueError(f"Plugin state directory is missing: {state_dir}. Run the setup action.")
    state_dir = state_dir.resolve()
    if state_dir.is_relative_to(source):
        raise ValueError("Plugin state directory must be outside the source repository.")
    workers_dir = state_dir / "workers"
    workers_dir.mkdir(exist_ok=True)
    if workers_dir.resolve() != workers_dir or not workers_dir.is_dir():
        raise ValueError("Plugin workers directory must be a real directory inside plugin state.")
    destination = workers_dir / worker_id
    try:
        destination.mkdir()
    except FileExistsError as exc:
        raise ValueError(f"Worker already exists: {worker_id}.") from exc
    try:
        clone = destination / "repo"
        git("clone", "--local", "--no-hardlinks", "--no-checkout", source, clone)
        git("-C", clone, "switch", "--detach", commit)
        git("-C", clone, "switch", "-c", branch)
        metadata = {
            "id": worker_id,
            "source_repo": str(source),
            "base_ref": base_ref,
            "base_commit": commit,
            "branch": branch,
            "created_at": datetime.now(timezone.utc).isoformat(),
            "runtime": "podman",
            "network": "online",
            "status": "created",
        }
        (destination / "worker.json").write_text(json.dumps(metadata, indent=2) + "\n")
    except (ValueError, OSError):
        shutil.rmtree(destination)
        raise
    return destination


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("setup")
    commands.add_parser("build-image")
    check_parser = commands.add_parser("check")
    check_parser.add_argument("--repo", help="Also verify a source Git repository")
    check_parser.add_argument("--execution", action="store_true", help="Also require dedicated Codex authentication")
    create_parser = commands.add_parser("create")
    create_parser.add_argument("--id", help="Worker ID (prompted for in an interactive terminal)")
    create_parser.add_argument("--repo", help="Source repository (defaults to the Herdr workspace)")
    create_parser.add_argument("--base", help="Base ref or commit (default: HEAD)")
    fetch_parser = commands.add_parser("fetch", help="Fetch one worker commit for review")
    fetch_parser.add_argument("--id", help="Worker ID (or configure [fetch].id)")
    cherry_pick_parser = commands.add_parser("cherry-pick", help="Cherry-pick one reviewed worker commit")
    cherry_pick_parser.add_argument("--id", help="Worker ID (or configure [cherry_pick].id)")
    cherry_pick_parser.add_argument("--commit", help="Full reviewed commit SHA (or configure [cherry_pick].commit)")
    destroy_parser = commands.add_parser("destroy", help="Destroy one sandbox worker")
    destroy_parser.add_argument("--id", help="Worker ID (or configure [destroy].id)")
    list_parser = commands.add_parser("list", help="List persisted sandbox workers")
    list_parser.add_argument("--json", action="store_true", help="Print structured JSON")
    inspect_parser = commands.add_parser("inspect", help="Inspect one sandbox worker")
    inspect_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    inspect_parser.add_argument("--id", dest="option_worker_id", help="Worker ID (for Herdr action configuration)")
    inspect_parser.add_argument("--json", action="store_true", help="Print structured JSON")
    open_parser = commands.add_parser("open", help="Open an interactive sandbox worker")
    open_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    open_parser.add_argument("--id", dest="option_worker_id", help="Worker ID (for Herdr action configuration)")
    open_parser.add_argument("session_command", nargs=argparse.REMAINDER, help="Command and arguments to run in the worker")
    execute_parser = commands.add_parser("execute", help="Run one noninteractive Codex task in a sandbox worker")
    execute_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    execute_parser.add_argument("prompt", nargs="?", help="Task prompt")
    execute_parser.add_argument("--id", dest="option_worker_id", help="Worker ID (for Herdr action configuration)")
    execute_parser.add_argument("--prompt", dest="option_prompt", help="Task prompt (for direct use)")
    workers_parser = commands.add_parser("workers", help=argparse.SUPPRESS)
    workers_parser.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    try:
        if args.command == "setup":
            setup()
        elif args.command == "build-image":
            build_image()
        elif args.command == "create":
            config_dir, _ = paths()
            options = create_options(config_dir)
            worker_id = args.id or options.get("id")
            if not worker_id and sys.stdin.isatty():
                worker_id = input("Worker ID: ").strip()
            if not worker_id:
                worker_id = f"worker-{uuid4().hex[:12]}"
            print(create_worker(worker_id, args.repo or options.get("source_repo"), args.base or options.get("base_ref") or "HEAD"))
        elif args.command == "destroy":
            worker_id = args.id
            if worker_id is None:
                config_dir, _ = paths()
                worker_id = destroy_options(config_dir).get("id")
            if not worker_id:
                raise ValueError("Worker ID is required. Pass `destroy --id WORKER_ID` or set [destroy].id in the plugin config.")
            removed = destroy_worker(worker_id)
            print(f"Destroyed worker: {worker_id}" if removed else f"Worker already absent: {worker_id}")
        elif args.command == "fetch":
            worker_id = args.id
            if worker_id is None:
                config_dir, _ = paths()
                worker_id = fetch_options(config_dir).get("id")
            if not worker_id:
                raise ValueError("Worker ID is required. Pass `fetch --id WORKER_ID` or set [fetch].id in the plugin config.")
            print(format_fetch_result(fetch_worker(worker_id)))
        elif args.command == "cherry-pick":
            worker_id, commit = args.id, args.commit
            if worker_id is None or commit is None:
                config_dir, _ = paths()
                options = cherry_pick_options(config_dir)
                worker_id = worker_id or options.get("id")
                commit = commit or options.get("commit")
            if not worker_id:
                raise ValueError("Worker ID is required. Pass `cherry-pick --id WORKER_ID --commit COMMIT` or set [cherry_pick].id in the plugin config.")
            if not commit:
                raise ValueError("Commit is required. Pass `cherry-pick --id WORKER_ID --commit COMMIT` or set [cherry_pick].commit in the plugin config.")
            print(format_cherry_pick_result(cherry_pick_worker(worker_id, commit)))
        elif args.command in {"list", "workers"}:
            records = list_workers()
            if args.json:
                print(json.dumps(records, indent=2))
            else:
                print(format_workers(records))
        elif args.command == "inspect":
            worker_id = args.worker_id or args.option_worker_id
            if not worker_id:
                config_dir, _ = paths()
                with (config_dir / "config.toml").open("rb") as stream:
                    config = tomllib.load(stream)
                inspect_options = config.get("inspect", {})
                if not isinstance(inspect_options, dict):
                    raise ValueError(f"Expected an [inspect] table in {config_dir / 'config.toml'}.")
                worker_id = inspect_options.get("id")
                if worker_id is not None and not isinstance(worker_id, str):
                    raise ValueError(f"Set [inspect].id to a string in {config_dir / 'config.toml'}.")
            if not worker_id:
                raise ValueError("Worker ID is required. Pass `inspect WORKER_ID` or set [inspect].id in the plugin config.")
            record = inspect_worker(worker_id)
            if args.json:
                print(json.dumps(record, indent=2))
            else:
                print(format_worker(record))
        elif args.command == "open":
            worker_id = args.worker_id or args.option_worker_id
            if not worker_id:
                config_dir, _ = paths()
                worker_id = open_options(config_dir).get("id")
            if not worker_id:
                raise ValueError("Worker ID is required. Pass `open WORKER_ID` or set [open].id in the plugin config.")
            command = args.session_command or ["bash"]
            return open_worker(worker_id, command)
        elif args.command == "execute":
            worker_id = args.worker_id or args.option_worker_id
            prompt = args.prompt or args.option_prompt
            if not worker_id or not prompt:
                config_dir, _ = paths()
                options = execute_options(config_dir)
                worker_id = worker_id or options.get("id")
                prompt = prompt or options.get("prompt")
            if not worker_id:
                raise ValueError("Worker ID is required. Pass `execute WORKER_ID PROMPT` or set [execute].id in the plugin config.")
            if not prompt:
                raise ValueError("Task prompt is required. Pass `execute WORKER_ID PROMPT` or set [execute].prompt in the plugin config.")
            result = execute_worker(worker_id, prompt)
            print_execution_result(result)
            return result["exit_status"]
        else:
            errors = check(args.repo or context_repo(), args.execution)
            if errors:
                raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
            print("Sandbox setup is ready.")
    except (ValueError, OSError, tomllib.TOMLDecodeError) as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
