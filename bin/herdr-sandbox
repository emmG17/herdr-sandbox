#!/usr/bin/env python3
"""Setup and readiness checks for the Herdr sandbox plugin."""

import argparse
import codecs
import fcntl
import json
import os
from pathlib import Path
import platform
import re
import secrets
import selectors
import shlex
import shutil
import subprocess
import sys
import tempfile
import tomllib
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from uuid import uuid4
import time


PLUGIN_ID = "dev.herdr.sandbox"
WORKER_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")
LIFECYCLE_STATES = {"created", "running", "stopped", "completed", "failed", "fetched"}
DEFAULT_CONFIG = (Path(__file__).resolve().parent.parent / "config.example.toml").read_text()
DEFAULT_BASE_IMAGE = "node:22-bookworm-slim"
SUPPORTED_PANE_PLACEMENTS = {"overlay", "split", "tab"}
SPLIT_DIRECTIONS = {"right", "down"}
MAX_WORKER_ID_LENGTH = 64
DEFAULT_GC_MAX_AGE = "7d"
GC_OPPORTUNISTIC_BUDGET_SECONDS = 2.0
DURATION_RE = re.compile(r"\A([1-9][0-9]*)([smhd])\Z")
DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}

# ---------------------------------------------------------------------------
# Agent profiles. Isolation flags stay on PodmanSandboxRuntime; a profile may
# only supply agent-specific home/env/argv/auth/forbidden-args/HERDR_AGENT.
# ---------------------------------------------------------------------------

@dataclass(frozen=True)
class AgentProfile:
    """Agent-specific launch and auth values. Cannot widen runtime isolation."""

    name: str
    home_dirname: str
    mount_point: str
    home_env_var: str
    auth_files: tuple
    login_argv: tuple
    interactive_bin: str
    workspace_flag: str
    forbidden_user_args: tuple
    herdr_agent: str
    normal_user_home: str
    noninteractive_prefix: tuple

    def normal_user_home_path(self):
        return (Path.home() / self.normal_user_home).expanduser().resolve()

    def validate_auth_data(self, data):
        """Return True when auth JSON has the expected object shape for this agent."""
        raise NotImplementedError

    def build_interactive_argv(self, command):
        args = list(command or [self.interactive_bin])
        if not args or any(not isinstance(arg, str) or not arg for arg in args):
            raise ValueError("Interactive command must contain nonempty arguments.")
        if args[0] != self.interactive_bin:
            raise ValueError(
                f"Fresh {self.name} sessions must start with the {self.interactive_bin} command."
            )
        for arg in args[1:]:
            if arg in self.forbidden_user_args or any(
                arg.startswith(f"{flag}=")
                for flag in self.forbidden_user_args
                if flag.startswith("--")
            ):
                raise ValueError(
                    f"Fresh {self.name} sessions must use the worker workspace at /workspace."
                )
        return [self.interactive_bin, self.workspace_flag, "/workspace", *args[1:]]

    def build_noninteractive_argv(self, prompt):
        if not isinstance(prompt, str) or not prompt.strip():
            raise ValueError("Execution prompt must be a nonempty string.")
        return [self.interactive_bin, *self.noninteractive_prefix, prompt]

    def host_env(self, base_env=None):
        """Environment for the host wrapper process (Herdr reads HERDR_AGENT here)."""
        env = dict(os.environ if base_env is None else base_env)
        env["HERDR_AGENT"] = self.herdr_agent
        return env


# BEGIN AGENT PROFILE: codex
def _codex_validate_auth_data(data):
    if not isinstance(data, dict) or not data:
        return False
    if "tokens" in data:
        tokens = data["tokens"]
        if not isinstance(tokens, dict):
            return False
        if not any(
            isinstance(tokens.get(key), str) and tokens.get(key)
            for key in ("access_token", "refresh_token", "id_token")
        ):
            return False
        return True
    api_key = data.get("OPENAI_API_KEY")
    return isinstance(api_key, str) and bool(api_key.strip())


@dataclass(frozen=True)
class _CodexAgentProfile(AgentProfile):
    def validate_auth_data(self, data):
        return _codex_validate_auth_data(data)


CODEX_PROFILE = _CodexAgentProfile(
    name="codex",
    home_dirname="codex",
    mount_point="/codex",
    home_env_var="CODEX_HOME",
    auth_files=("auth.json",),
    login_argv=("codex", "login", "--device-auth"),
    interactive_bin="codex",
    workspace_flag="--cd",
    forbidden_user_args=("-C", "--cd"),
    herdr_agent="codex",
    normal_user_home=".codex",
    noninteractive_prefix=("exec", "--sandbox", "danger-full-access"),
)
# END AGENT PROFILE: codex

AGENT_PROFILES = {CODEX_PROFILE.name: CODEX_PROFILE}
DEFAULT_PROFILE = CODEX_PROFILE


def get_profile(name):
    """Resolve a registered agent profile by name."""
    if not isinstance(name, str) or not name.strip():
        raise ValueError("Agent name is required.")
    profile = AGENT_PROFILES.get(name)
    if profile is None:
        known = ", ".join(sorted(AGENT_PROFILES))
        raise ValueError(f"Unknown agent {name!r}. Known agents: {known}.")
    return profile



def paths():
    config = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
    state = os.environ.get("HERDR_PLUGIN_STATE_DIR")
    if not config or not state:
        raise ValueError("Herdr plugin paths are missing. Run this through `herdr plugin action invoke` or set HERDR_PLUGIN_CONFIG_DIR and HERDR_PLUGIN_STATE_DIR.")
    return Path(config), Path(state)


def _permitted_settings(table, table_name, permitted):
    """Reject configuration that could expand the fixed runtime contract."""
    unexpected = sorted(set(table) - set(permitted))
    if unexpected:
        raise ValueError(
            f"{table_name} setting(s) are not permitted: {', '.join(unexpected)}. "
            "Worker isolation settings are fixed by PodmanSandboxRuntime."
        )


def _read_config_toml(config_dir):
    config_file = Path(config_dir) / "config.toml"
    if not config_file.is_file():
        raise ValueError(f"Missing {config_file}. Run `herdr plugin action invoke setup --plugin {PLUGIN_ID}`.")
    with config_file.open("rb") as stream:
        return config_file, tomllib.load(stream)


def resolve_agent_home(config_dir, profile, config=None):
    """Resolve the plugin-owned home for one agent profile.

    Per-agent convention: default dirname is ``profile.home_dirname`` under the
    config directory. A ``[<agent>].home`` table remains a compatibility
    override. Every profile's normal user home is refused.
    """
    config_dir = Path(config_dir)
    if config is None:
        _, config = _read_config_toml(config_dir)
    config_file = config_dir / "config.toml"
    table = config.get(profile.name)
    if table is None:
        home = profile.home_dirname
    elif not isinstance(table, dict):
        raise ValueError(f"Expected [{profile.name}] table in {config_file}.")
    else:
        _permitted_settings(table, f"[{profile.name}]", {"home"})
        home = table.get("home", profile.home_dirname)
    if not isinstance(home, str) or home in ("", ".") or Path(home).is_absolute() or ".." in Path(home).parts:
        raise ValueError(f"Set [{profile.name}].home to a relative path inside {config_dir}.")
    agent_home = (config_dir / home).resolve()
    if agent_home == config_dir.resolve() or not agent_home.is_relative_to(config_dir.resolve()):
        raise ValueError(f"{profile.name} home escapes plugin config directory: {agent_home}.")
    banned = {other.normal_user_home_path() for other in AGENT_PROFILES.values()}
    if agent_home in banned:
        raise ValueError(
            f"The normal user {profile.name} home cannot be used by this plugin."
        )
    return agent_home


def load_config(config_dir, profile=None):
    """Load runtime image and the dedicated home for ``profile`` (default agent)."""
    profile = DEFAULT_PROFILE if profile is None else profile
    config_file, config = _read_config_toml(config_dir)
    runtime = config.get("runtime")
    agent_table = config.get(profile.name)
    if not isinstance(runtime, dict) or not isinstance(agent_table, dict):
        raise ValueError(f"Expected [runtime] and [{profile.name}] tables in {config_file}.")
    _permitted_settings(runtime, "[runtime]", {"image", "network"})
    image = runtime.get("image")
    if not isinstance(image, str) or not image.strip():
        raise ValueError(f"Set a nonempty [runtime].image in {config_file}.")
    return image, resolve_agent_home(config_dir, profile, config)


def runtime_settings(config_dir):
    """Load the fixed Podman settings shared by every worker entrypoint."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    runtime = config.get("runtime")
    resources = config.get("resources")
    if not isinstance(runtime, dict) or not isinstance(resources, dict):
        raise ValueError(f"Expected [runtime] and [resources] tables in {config_file}.")
    _permitted_settings(runtime, "[runtime]", {"image", "network"})
    _permitted_settings(resources, "[resources]", {"cpus", "memory", "pids"})
    network = runtime.get("network")
    cpus, memory, pids = resources.get("cpus"), resources.get("memory"), resources.get("pids")
    if network not in {"online", "offline"}:
        raise ValueError(f"Set [runtime].network to 'online' or 'offline' in {config_file}.")
    if not isinstance(cpus, (int, float)) or isinstance(cpus, bool) or cpus <= 0:
        raise ValueError(f"Set [resources].cpus to a positive number in {config_file}.")
    if not isinstance(memory, str) or not re.fullmatch(r"[1-9][0-9]*(?:[kKmMgGtT][iI]?[bB]?|[bB])?", memory):
        raise ValueError(f"Set [resources].memory to a positive Podman memory value in {config_file}.")
    if not isinstance(pids, int) or isinstance(pids, bool) or pids <= 0:
        raise ValueError(f"Set [resources].pids to a positive integer in {config_file}.")
    return network, cpus, memory, pids


def build_settings(config_dir):
    """Load the user-selectable base image for the editable boilerplate."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    build = config.get("build", {})
    if not isinstance(build, dict):
        raise ValueError(f"Expected a [build] table in {config_file}.")
    _permitted_settings(build, "[build]", {"base_image"})
    base_image = build.get("base_image", DEFAULT_BASE_IMAGE)
    if not isinstance(base_image, str) or not base_image.strip() or any(char.isspace() for char in base_image):
        raise ValueError(f"Set [build].base_image to a nonempty image reference without whitespace in {config_file}.")
    return base_image


def _validate_worker_git_dir(worker_repo):
    """Return the worker .git directory after refusing symlinks and escapes."""
    worker_repo = Path(worker_repo)
    if worker_repo.is_symlink() or not worker_repo.is_dir():
        raise ValueError(f"Worker repository is not a real directory: {worker_repo}")
    git_dir = worker_repo / ".git"
    if git_dir.is_symlink() or not git_dir.is_dir():
        raise ValueError(f"Worker .git is not a real directory: {git_dir}")
    return git_dir


def _confine_under(path, root):
    """Resolve path and require it to stay under root without symlink escapes."""
    root = Path(root).resolve()
    candidate = Path(path)
    if candidate.is_symlink():
        raise ValueError(f"Symlink is not allowed: {candidate}")
    resolved = candidate.resolve()
    if not resolved.is_relative_to(root):
        raise ValueError(f"Path escapes allowed directory: {candidate}")
    return resolved


def _safe_read_worker_ref(worker_repo, branch):
    """Read refs/heads/<branch> from loose or packed-refs without running git.

    Refuses symlinks and confines all paths under the worker .git directory.
    Returns the 40-character SHA, or None if the ref is missing.
    """
    if not isinstance(branch, str) or not branch or branch.startswith("-"):
        raise ValueError(f"Invalid branch name: {branch!r}")
    if any(part in {"", ".", ".."} for part in branch.split("/")):
        raise ValueError(f"Invalid branch name: {branch!r}")

    git_dir = _validate_worker_git_dir(worker_repo)
    git_root = git_dir.resolve()
    heads_root = _confine_under(git_dir / "refs" / "heads", git_root)
    if (git_dir / "refs").is_symlink() or (git_dir / "refs" / "heads").is_symlink():
        raise ValueError("Worker refs directories must not be symlinks")

    # Walk each path component under refs/heads so nested branches (agent/id) are safe.
    current = heads_root
    for part in branch.split("/"):
        current = current / part
        if current.is_symlink():
            raise ValueError(f"Ref path contains a symlink: {branch}")
        if current.exists() and current.is_dir():
            _confine_under(current, heads_root)

    if current.is_file():
        _confine_under(current, heads_root)
        try:
            sha = current.read_text().strip()
        except (OSError, UnicodeDecodeError) as exc:
            raise ValueError(f"Cannot read worker ref {branch}: {exc}") from exc
        if not re.fullmatch(r"[0-9a-fA-F]{40}", sha):
            raise ValueError(f"Invalid SHA in worker ref {branch}: {sha}")
        return sha

    packed_refs = git_dir / "packed-refs"
    if packed_refs.is_symlink():
        raise ValueError("Worker packed-refs must not be a symlink")
    if packed_refs.is_file():
        _confine_under(packed_refs, git_root)
        full_ref = f"refs/heads/{branch}"
        try:
            for line in packed_refs.read_text().splitlines():
                if not line or line.startswith("#") or line.startswith("^"):
                    continue
                parts = line.split()
                if len(parts) >= 2 and parts[1] == full_ref:
                    sha = parts[0]
                    if not re.fullmatch(r"[0-9a-fA-F]{40}", sha):
                        raise ValueError(f"Invalid SHA in packed-refs for {branch}: {sha}")
                    return sha
        except (OSError, UnicodeDecodeError) as exc:
            raise ValueError(f"Cannot read packed-refs: {exc}") from exc
    return None


LOOSE_OBJECT_RE = re.compile(r"^[0-9a-f]{2}/[0-9a-f]{38}$")
PACK_FILE_RE = re.compile(r"^pack/pack-[0-9a-f]{40}\.pack$")


def _copy_worker_objects(worker_objects, destination_objects):
    """Copy only loose objects and pack payloads into a trusted repo.

    Skips commit-graphs, multi-pack-indexes, bitmaps, .idx/.rev files, and
    objects/info/* so host git never consumes attacker-controlled auxiliary
    data. Pack indexes are regenerated later with `git index-pack`.
    Returns the list of copied pack file paths under destination_objects.
    """
    if worker_objects.is_symlink() or not worker_objects.is_dir():
        raise ValueError(f"Worker objects directory is not a real directory: {worker_objects}")
    source_root = worker_objects.resolve()
    destination_objects.mkdir(parents=True, exist_ok=True)
    copied_packs = []

    for dirpath, dirnames, filenames in os.walk(worker_objects, followlinks=False):
        current = Path(dirpath)
        if current.is_symlink():
            raise ValueError(f"Symlink in worker objects tree: {current}")
        _confine_under(current, source_root)
        dirnames[:] = [name for name in dirnames if not (current / name).is_symlink()]
        relative = current.relative_to(worker_objects)
        for name in filenames:
            source_file = current / name
            if source_file.is_symlink():
                raise ValueError(f"Symlink in worker objects tree: {source_file}")
            _confine_under(source_file, source_root)
            relative_file = (relative / name).as_posix()
            if LOOSE_OBJECT_RE.fullmatch(relative_file):
                target = destination_objects / relative / name
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source_file, target)
            elif PACK_FILE_RE.fullmatch(relative_file):
                target = destination_objects / relative / name
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source_file, target)
                copied_packs.append(target)
            # All other files (commit-graph, MIDX, bitmap, idx, rev, info/*) are skipped.
    return copied_packs


def _index_copied_packs(bare_repo, pack_files):
    """Regenerate pack indexes in the trusted temp repo with git index-pack."""
    for pack_file in pack_files:
        result = subprocess.run(
            ["git", "--git-dir", str(bare_repo), "index-pack", str(pack_file)],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode:
            raise ValueError(
                f"Failed to index worker pack {pack_file.name}: "
                f"{result.stderr.strip() or result.stdout.strip() or 'git index-pack failed'}"
            )


def validate_sandbox_result_branch(branch):
    """Validate a forced-update destination under refs/heads/sandbox/ only.

    Wildcards and prune-style patterns are rejected. The forced update may only
    target a single concrete sandbox/<id> branch.
    """
    if not isinstance(branch, str) or not branch:
        raise ValueError("Sandbox result branch is required.")
    if not branch.startswith("sandbox/"):
        raise ValueError(
            f"Forced fetch destination must be under sandbox/: {branch!r}"
        )
    rest = branch[len("sandbox/"):]
    if not rest or any(part in {"", ".", ".."} for part in rest.split("/")):
        raise ValueError(f"Invalid sandbox result branch: {branch!r}")
    if any(char in branch for char in "*?[]\\"):
        raise ValueError(f"Sandbox result branch must not contain wildcards: {branch!r}")
    if branch.startswith("-") or any(char.isspace() for char in branch):
        raise ValueError(f"Invalid sandbox result branch: {branch!r}")
    check = run("git", "check-ref-format", "--branch", branch)
    if check.returncode:
        raise ValueError(f"Invalid sandbox result branch: {branch!r}")
    return branch


def _sandbox_branch_checkout_path(source_repo, sandbox_branch):
    """Return the worktree path if sandbox_branch is checked out, else None.

    Git refuses to fetch into a checked-out branch. Callers must fail before
    fetch; never pass --update-head-ok.
    """
    validate_sandbox_result_branch(sandbox_branch)
    full_ref = f"refs/heads/{sandbox_branch}"
    result = run("git", "-C", str(source_repo), "worktree", "list", "--porcelain")
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "git worktree list failed"
        raise ValueError(f"Unable to list worktrees in {source_repo}: {detail}")
    current_path = None
    for line in result.stdout.splitlines():
        if line.startswith("worktree "):
            current_path = line[len("worktree "):]
        elif line.startswith("branch ") and current_path is not None:
            if line[len("branch "):] == full_ref:
                return current_path
        elif line == "":
            current_path = None
    return None


def _safe_fetch_from_worker(source_repo, worker_repo, worker_branch, target_branch):
    """Import a worker branch into the source repo without trusting worker git config.

    1. Read the worker tip SHA from loose or packed refs (no git, no symlinks).
    2. Build a temporary bare repository we own.
    3. Copy only loose objects and pack-*.pack files; regenerate indexes with
       `git index-pack` (skip commit-graph/MIDX/bitmaps/info).
    4. Write the branch tip in the temp repo and create a git bundle there.
    5. `git bundle verify`, then `git -C <source> fetch` with fsckObjects into
       the source repo only, forced to refs/heads/sandbox/<id>.

    The source repository is untouched until step 5. Failure or a crash before a
    successful fetch leaves no alternates, no dangling sandbox ref, and no
    dependency on the worker object store.

    Destination validation: only a concrete refs/heads/sandbox/<id> may be
    updated. Never uses wildcard refspecs, --prune, or --update-head-ok.
    """
    source_repo = Path(source_repo)
    worker_repo = Path(worker_repo)
    target_branch = validate_sandbox_result_branch(target_branch)
    if not isinstance(worker_branch, str) or not worker_branch or worker_branch.startswith("-"):
        raise ValueError(f"Invalid worker branch: {worker_branch!r}")
    if any(char in worker_branch for char in "*?[]\\") or any(
        part in {"", ".", ".."} for part in worker_branch.split("/")
    ):
        raise ValueError(f"Invalid worker branch: {worker_branch!r}")

    worker_commit = _safe_read_worker_ref(worker_repo, worker_branch)
    if worker_commit is None:
        raise ValueError(f"Worker branch {worker_branch} does not exist")

    git_dir = _validate_worker_git_dir(worker_repo)
    worker_objects = git_dir / "objects"
    if worker_objects.is_symlink() or not worker_objects.is_dir():
        raise ValueError(f"Worker objects directory is not a real directory: {worker_objects}")

    temp_root = Path(tempfile.mkdtemp(prefix="herdr-safe-fetch-"))
    try:
        bare = temp_root / "export.git"
        bundle_path = temp_root / "worker.bundle"
        init = subprocess.run(
            ["git", "init", "--bare", "-q", str(bare)],
            capture_output=True,
            text=True,
            check=False,
        )
        if init.returncode:
            raise ValueError(init.stderr.strip() or "Failed to create temporary git repository")

        pack_files = _copy_worker_objects(worker_objects, bare / "objects")
        _index_copied_packs(bare, pack_files)

        ref_path = bare / "refs" / "heads" / worker_branch
        ref_path.parent.mkdir(parents=True, exist_ok=True)
        ref_path.write_text(worker_commit + "\n")

        create = subprocess.run(
            ["git", "--git-dir", str(bare), "bundle", "create", str(bundle_path), worker_branch],
            capture_output=True,
            text=True,
            check=False,
        )
        if create.returncode:
            raise ValueError(create.stderr.strip() or "Failed to create worker bundle")

        verify = subprocess.run(
            ["git", "bundle", "verify", str(bundle_path)],
            capture_output=True,
            text=True,
            check=False,
        )
        if verify.returncode:
            raise ValueError(verify.stderr.strip() or "Worker bundle failed verification")

        # Single forced refspec into sandbox/ only. No wildcards, no --prune,
        # no --update-head-ok. Results live on the branch, not FETCH_HEAD.
        refspec = f"+{worker_branch}:refs/heads/{target_branch}"
        fetch = subprocess.run(
            [
                "git",
                "-c", "fetch.fsckObjects=true",
                "-c", "transfer.fsckObjects=true",
                "-C", str(source_repo), "fetch",
                "--no-tags",
                "--no-write-fetch-head",
                "--no-recurse-submodules",
                str(bundle_path),
                refspec,
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if fetch.returncode:
            raise ValueError(fetch.stderr.strip() or "Failed to fetch worker bundle into source repository")
    finally:
        shutil.rmtree(temp_root, ignore_errors=True)

    return worker_commit


def run(*argv, env=None):
    """Run a command with optional environment override."""
    return subprocess.run(argv, capture_output=True, text=True, check=False, env=env)


def host_errors():
    errors = []
    if platform.system() != "Linux":
        errors.append("Linux is required for the rootless Podman worker.")
    if shutil.which("git") is None:
        errors.append("Git is missing. Install git and retry.")
    if shutil.which("podman") is None:
        errors.append("Podman is missing. Install and configure rootless Podman.")
    elif platform.system() == "Linux":
        result = run("podman", "info", "--format", "{{.Host.Security.Rootless}}")
        if result.returncode != 0:
            errors.append(f"Podman is unavailable: {result.stderr.strip() or result.stdout.strip()}. Fix rootless Podman and retry.")
        elif result.stdout.strip().lower() != "true":
            errors.append("Podman is running as root. Configure rootless Podman and retry.")
    return errors


def check_source(repo):
    source = Path(repo).expanduser().resolve()
    if not source.is_dir():
        return f"Source repository does not exist: {source}."
    result = run("git", "-C", str(source), "rev-parse", "--show-toplevel")
    if result.returncode != 0 or Path(result.stdout.strip()).resolve() != source:
        return f"Source must be the root of a Git repository: {source}."
    return None


def context_repo():
    raw = os.environ.get("HERDR_PLUGIN_CONTEXT_JSON")
    if not raw:
        return None
    try:
        context = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError(f"Invalid HERDR_PLUGIN_CONTEXT_JSON: {exc}.") from exc
    if not isinstance(context, dict):
        raise ValueError("HERDR_PLUGIN_CONTEXT_JSON must be an object.")
    repo = context.get("workspace_cwd")
    if repo is not None and not isinstance(repo, str):
        raise ValueError("Herdr workspace path must be a string.")
    return repo


def context_repo_root():
    """Resolve Herdr's workspace context to its Git repository root."""
    repo = context_repo()
    if repo is None:
        return None
    candidate = Path(repo).expanduser().resolve()
    if not candidate.is_dir():
        raise ValueError(f"Herdr workspace context is not a directory: {candidate}.")
    result = run("git", "-C", str(candidate), "rev-parse", "--show-toplevel")
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "Git could not resolve the workspace."
        raise ValueError(f"Herdr workspace context is not a Git repository: {candidate} ({detail}).")
    return Path(result.stdout.strip()).resolve()


def plugin_root():
    """Resolve the installed or linked plugin root used by setup artifacts."""
    return Path(os.environ.get("HERDR_PLUGIN_ROOT", Path(__file__).resolve().parent.parent)).expanduser().resolve()


def plugin_script_path():
    script = plugin_root() / "bin" / "herdr-sandbox"
    if not script.is_file() or script.is_symlink():
        raise ValueError(f"Plugin script is missing or unsafe: {script}")
    return script


def write_launcher(config_dir, state_dir):
    """Create the config-owned, argument-preserving direct CLI launcher."""
    launcher = Path(config_dir) / "herdr-sandbox"
    if launcher.is_symlink() or (launcher.exists() and not launcher.is_file()):
        raise ValueError(f"Launcher path is not a regular file: {launcher}")
    config_path = Path(config_dir).resolve()
    state_path = Path(state_dir).resolve()
    script_path = plugin_script_path()
    launcher.write_text(
        "#!/usr/bin/env python3\n"
        "import os\n"
        "import sys\n\n"
        f"os.environ['HERDR_PLUGIN_CONFIG_DIR'] = {json.dumps(str(config_path))}\n"
        f"os.environ['HERDR_PLUGIN_STATE_DIR'] = {json.dumps(str(state_path))}\n"
        f"os.execv(sys.executable, [sys.executable, {json.dumps(str(script_path))}, *sys.argv[1:]])\n"
    )
    launcher.chmod(0o700)
    return launcher


def install_hs_to_path():
    """Install hs shim to ~/.local/bin that resolves plugin root at runtime.
    
    Creates a standalone shim instead of a symlink so it survives plugin updates.
    The shim queries the current plugin root from Herdr each time it runs.
    """
    local_bin = Path.home() / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    
    hs_dest = local_bin / "hs"
    
    # Create a standalone shim that queries the plugin root from Herdr
    # Uses 'herdr plugin list --json' instead of 'plugin root' for Herdr 0.9.5 compatibility
    shim_content = '''\
#!/usr/bin/env python3
"""hs - Herdr sandbox launcher (installed shim).

This shim resolves the current plugin root at runtime, making it resilient to
plugin updates. It queries Herdr for the plugin root via plugin list JSON, then
delegates to the bin/hs script in that root.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

PLUGIN_ID = "dev.herdr.sandbox"

def find_herdr_bin():
    """Locate the herdr binary."""
    if "HERDR_BIN_PATH" in os.environ:
        herdr = Path(os.environ["HERDR_BIN_PATH"]).resolve()
        if herdr.is_file():
            return str(herdr)
    
    import shutil
    herdr = shutil.which("herdr")
    if herdr:
        return herdr
    
    print("Error: herdr not found. Install Herdr or set HERDR_BIN_PATH.", file=sys.stderr)
    sys.exit(1)

def main():
    herdr = find_herdr_bin()
    
    # Query the current plugin root from JSON (Herdr 0.9.5 compatible)
    result = subprocess.run(
        [herdr, "plugin", "list", "--plugin", PLUGIN_ID, "--json"],
        capture_output=True,
        text=True,
        check=False
    )
    
    if result.returncode != 0:
        print(f"Error: herdr plugin list failed: {result.stderr.strip()}", file=sys.stderr)
        print(f"Plugin may not be installed. Run: herdr plugin install emmG17/herdr-sandbox", file=sys.stderr)
        sys.exit(1)
    
    try:
        data = json.loads(result.stdout)
        plugins = data.get("result", {}).get("plugins", [])
        if not plugins or len(plugins) == 0:
            print(f"Error: Plugin {PLUGIN_ID} not found in herdr", file=sys.stderr)
            print(f"Run: herdr plugin install emmG17/herdr-sandbox", file=sys.stderr)
            sys.exit(1)
        
        plugin_root_str = plugins[0].get("plugin_root")
        if not plugin_root_str:
            print(f"Error: Plugin root not found in herdr plugin list output", file=sys.stderr)
            sys.exit(1)
        
        plugin_root = Path(plugin_root_str).resolve()
    except (json.JSONDecodeError, KeyError, IndexError) as exc:
        print(f"Error: Could not parse plugin list output: {exc}", file=sys.stderr)
        sys.exit(1)
    
    hs_script = plugin_root / "bin" / "hs"
    
    if not hs_script.is_file():
        print(f"Error: hs script not found in plugin: {hs_script}", file=sys.stderr)
        sys.exit(1)
    
    # Execute the plugin's hs script
    os.execv(sys.executable, [sys.executable, str(hs_script), *sys.argv[1:]])

if __name__ == "__main__":
    main()
'''
    
    hs_dest.write_text(shim_content)
    hs_dest.chmod(0o755)
    
    return hs_dest


def _login_hint(profile, agent_home):
    login = " ".join(profile.login_argv)
    return f"`{profile.home_env_var}={agent_home} {login}`"


def check(repo=None, require_auth=False, profile=None):
    profile = DEFAULT_PROFILE if profile is None else profile
    errors = host_errors()
    try:
        config_dir, state_dir = paths()
        if not config_dir.is_dir():
            errors.append(f"Plugin config directory is missing: {config_dir}. Run the setup action.")
        if not state_dir.is_dir():
            errors.append(f"Plugin state directory is missing: {state_dir}. Run the setup action.")
        image, agent_home = load_config(config_dir, profile)
        runtime_settings(config_dir)
        if not agent_home.is_dir():
            errors.append(f"Dedicated {profile.name} home is missing: {agent_home}. Run the setup action.")
        elif require_auth:
            missing = [
                name for name in profile.auth_files
                if (agent_home / name).is_symlink() or not (agent_home / name).is_file()
            ]
            if missing:
                errors.append(
                    f"{profile.name} authentication is missing in {agent_home} "
                    f"({', '.join(missing)}). Run {_login_hint(profile, agent_home)}."
                )
        if shutil.which("podman") and platform.system() == "Linux":
            result = run("podman", "image", "exists", image)
            if result.returncode != 0:
                errors.append(f"Worker image {image} is missing. Run `herdr plugin action invoke build-image --plugin {PLUGIN_ID}`.")
    except (ValueError, OSError, tomllib.TOMLDecodeError) as exc:
        errors.append(str(exc))
    if repo is not None and shutil.which("git"):
        source_error = check_source(repo)
        if source_error:
            errors.append(source_error)
    return errors


def setup():
    config_dir, state_dir = paths()
    config_dir.mkdir(parents=True, exist_ok=True)
    state_dir.mkdir(parents=True, exist_ok=True)
    config_file = config_dir / "config.toml"
    if not config_file.exists():
        config_file.write_text(DEFAULT_CONFIG)
    image_dir = config_dir / "image"
    image_dir.mkdir(exist_ok=True)
    boilerplate = image_dir / "Containerfile"
    if not boilerplate.exists():
        boilerplate.write_text((plugin_root() / "Containerfile").read_text())
    image, agent_home = load_config(config_dir, DEFAULT_PROFILE)
    for profile in AGENT_PROFILES.values():
        home = resolve_agent_home(config_dir, profile)
        home.mkdir(parents=True, exist_ok=True)
        home.chmod(0o700)
    launcher = write_launcher(config_dir, state_dir)
    try:
        hs_shim = install_hs_to_path()
        hs_installed = f"\nhs CLI: Installed shim to {hs_shim} (resolves plugin root at runtime)"
        hs_path_check = ""
        if str(hs_shim.parent) not in os.environ.get("PATH", "").split(os.pathsep):
            hs_path_check = f"\nNote: {hs_shim.parent} is not on PATH. Add it or use the full path."
    except Exception as exc:
        hs_installed = (
            f"\nhs CLI installation failed: {exc}\n"
            f"Manually add {plugin_root() / 'bin'} to PATH to use `hs {DEFAULT_PROFILE.name}`"
        )
        hs_path_check = ""
    print(
        f"Config: {config_file}\nImage boilerplate: {boilerplate}\nLauncher: {launcher}\n"
        f"State: {state_dir}\n{DEFAULT_PROFILE.name} home: {agent_home}\nImage: {image}"
        f"{hs_installed}{hs_path_check}"
    )
    print(f"Next: `herdr plugin action invoke build-image --plugin {PLUGIN_ID}`")
    print(f"Authenticate: hs login {DEFAULT_PROFILE.name}")
    print(f"  (or {_login_hint(DEFAULT_PROFILE, agent_home)})")


def bootstrap():
    """Prepare the plugin for first use without requiring config-file edits."""
    setup()
    build_image()
    config_dir, _ = paths()
    _, agent_home = load_config(config_dir, DEFAULT_PROFILE)
    errors = check(require_auth=True, profile=DEFAULT_PROFILE)
    auth_marker = f"{DEFAULT_PROFILE.name} authentication is missing"
    remaining = [error for error in errors if auth_marker not in error]
    if remaining:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(remaining))
    if errors:
        print(f"Almost ready. Authenticate once:\n  hs login {DEFAULT_PROFILE.name}")
        print(f"  (or {_login_hint(DEFAULT_PROFILE, agent_home)})")
    else:
        print(
            f"Sandbox setup is ready. Use `hs {DEFAULT_PROFILE.name}` from any Git repository pane, "
            "or create a worker with the Create Worker action."
        )


def build_image():
    errors = host_errors()
    if errors:
        raise ValueError("\n".join(errors))
    config_dir, _ = paths()
    image, _ = load_config(config_dir)
    base_image = build_settings(config_dir)
    image_dir = config_dir / "image"
    boilerplate = image_dir / "Containerfile"
    if not boilerplate.is_file() or boilerplate.is_symlink():
        raise ValueError(f"Worker image boilerplate is missing: {boilerplate}. Run the setup action.")
    result = subprocess.run([
        "podman", "build", "--tag", image, "--build-arg", f"BASE_IMAGE={base_image}",
        "--file", str(boilerplate), str(image_dir),
    ], check=False)
    if result.returncode:
        raise ValueError(f"Image build failed with exit code {result.returncode}.")
    print(f"Built {image}")


def git(*args):
    result = run("git", *map(str, args))
    if result.returncode:
        raise ValueError(result.stderr.strip() or result.stdout.strip() or "Git command failed.")
    return result.stdout.strip()


def source_git_identity(source):
    """Resolve and validate only the source repository's effective identity."""
    identity = {}
    missing = []
    for key in ("user.name", "user.email"):
        result = run("git", "-C", source, "config", "--get", key)
        value = (result.stdout or "").rstrip("\n")
        if result.returncode != 0 or not value.strip():
            missing.append(key)
        elif any(ord(char) < 32 or ord(char) == 127 for char in value):
            missing.append(f"{key} (contains control characters)")
        else:
            identity[key] = value
    if missing:
        quoted_source = shlex.quote(source)
        settings = " and ".join(f'`git -C {quoted_source} config {key} "..."`' for key in ("user.name", "user.email"))
        detail = ", ".join(missing)
        raise ValueError(
            f"Source Git identity is missing or invalid ({detail}) for {source}. "
            f"Set it locally or globally with {settings}, then retry worker creation."
        )

    identity_check = run("git", "-C", source, "var", "GIT_AUTHOR_IDENT")
    if identity_check.returncode:
        detail = identity_check.stderr.strip() or identity_check.stdout.strip() or "Git rejected the configured identity"
        quoted_source = shlex.quote(source)
        raise ValueError(
            f"Source Git identity is invalid for {source}: {detail}. "
            f"Set nonempty user.name and user.email with `git -C {quoted_source} config user.name ...` "
            f"and `git -C {quoted_source} config user.email ...`, then retry worker creation."
        )
    return identity["user.name"], identity["user.email"]


def validate_worker_id(worker_id):
    """Validate an ID before it is used as a worker path or container name."""
    if not isinstance(worker_id, str) or not WORKER_ID_RE.fullmatch(worker_id) or ".." in worker_id:
        raise ValueError("Worker ID must contain letters, digits, dots, underscores, or hyphens, start with a letter or digit, and contain no '..'.")
    return worker_id


def state_workers_dir(state_dir=None):
    """Return the plugin-owned worker directory without requiring setup config."""
    if state_dir is None:
        _, state_dir = paths()
    return Path(state_dir).expanduser().resolve() / "workers"


def worker_dir_for(worker_id, state_dir=None):
    validate_worker_id(worker_id)
    return state_workers_dir(state_dir) / worker_id


def worker_storage(worker_id, state_dir=None):
    """Resolve a worker path without following an escape through worker state."""
    workers_dir = state_workers_dir(state_dir)
    state_root = workers_dir.parent
    if state_root.exists() and not state_root.is_dir():
        raise ValueError(f"Plugin state path is not a directory: {state_root}.")
    if workers_dir.is_symlink() or (workers_dir.exists() and not workers_dir.is_dir()):
        raise ValueError(f"Worker state directory is not a real directory: {workers_dir}")

    worker_dir = worker_dir_for(worker_id, state_dir)
    if worker_dir.is_symlink():
        raise ValueError(f"Worker path is not a real directory inside plugin workers: {worker_dir}")
    if not worker_dir.resolve().is_relative_to(workers_dir.resolve()):
        raise ValueError(f"Worker path escapes plugin workers directory: {worker_dir}")
    if worker_dir.exists() and not worker_dir.is_dir():
        raise ValueError(f"Worker path is not a directory: {worker_dir}")
    return workers_dir, worker_dir


def worker_source_repo(worker_id, state_dir=None):
    """Read and validate the source repository recorded for one worker."""
    _, worker_dir = worker_storage(worker_id, state_dir)
    metadata_path = worker_dir / "worker.json"
    try:
        with metadata_path.open() as stream:
            metadata = json.load(stream)
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Invalid worker metadata: {metadata_path}") from exc
    if not isinstance(metadata, dict) or metadata.get("id") != worker_id or not isinstance(metadata.get("source_repo"), str):
        raise ValueError(f"Invalid worker metadata for {worker_id}: {metadata_path}")
    source = Path(metadata["source_repo"]).expanduser().resolve()
    source_error = check_source(source)
    if source_error:
        raise ValueError(source_error)
    return source


def validate_open_context(worker_id):
    """Refuse an interactive launch from a different Herdr workspace."""
    workspace = context_repo_root()
    if workspace is None:
        if os.environ.get("HERDR_ENV") == "1":
            raise ValueError(
                "Herdr workspace context is missing; refusing to open worker. "
                "Invoke this action from the worker's source workspace."
            )
        return
    source = worker_source_repo(worker_id)
    if workspace != source:
        raise ValueError(
            f"Selected worker {worker_id} belongs to {source}, but the Herdr workspace is {workspace}. "
            "Refusing to open a worker in a mismatched workspace."
        )


def _auth_snapshot(path):
    """Capture content and mtime of a regular auth file; refuse symlinks."""
    path = Path(path)
    if path.is_symlink():
        raise ValueError(f"Auth file must not be a symlink: {path}")
    if not path.is_file():
        raise ValueError(f"Auth file is missing: {path}")
    data = path.read_bytes()
    mtime_ns = path.stat().st_mtime_ns
    return {"path": path, "data": data, "mtime_ns": mtime_ns}


def fresh_agent_home(agent_home, worker_id, profile):
    """Create a disposable agent home containing auth files but no history.

    Returns ``(session_home, launch_snapshots)`` where snapshots map auth file
    names to the dedicated-home bytes/mtime captured at launch for write-back.
    """
    agent_home = Path(agent_home)
    snapshots = {}
    for name in profile.auth_files:
        auth_path = agent_home / name
        if auth_path.is_symlink() or not auth_path.is_file():
            raise ValueError(f"{profile.name} authentication is missing in {agent_home}.")
        snapshots[name] = _auth_snapshot(auth_path)

    sessions_dir = agent_home / "sessions"
    if sessions_dir.is_symlink() or (sessions_dir.exists() and not sessions_dir.is_dir()):
        raise ValueError(f"{profile.name} session storage is not a real directory: {sessions_dir}.")
    sessions_dir.mkdir(mode=0o700, exist_ok=True)
    sessions_dir.chmod(0o700)
    session_home = Path(tempfile.mkdtemp(prefix=f"{worker_id}-", dir=sessions_dir))
    try:
        session_home.chmod(0o700)
        for name, snap in snapshots.items():
            dest = session_home / name
            with open(snap["path"], "rb") as src, open(dest, "wb") as out:
                out.write(src.read())
            dest.chmod(0o600)
    except (OSError, shutil.Error):
        shutil.rmtree(session_home, ignore_errors=True)
        raise
    if not session_home.resolve().is_relative_to(agent_home.resolve()):
        shutil.rmtree(session_home, ignore_errors=True)
        raise ValueError(f"Fresh {profile.name} home escapes plugin config directory: {session_home}.")
    return session_home, snapshots


def _atomic_write_bytes(path, data, mode=0o600):
    """Write bytes atomically (temp + fsync + rename) without following symlinks."""
    path = Path(path)
    parent = path.parent
    if path.is_symlink() or parent.is_symlink():
        raise ValueError(f"Refusing to write through a symlink: {path}")
    if path.exists() and not path.is_file():
        raise ValueError(f"Auth destination is not a regular file: {path}")
    fd, temp_path = tempfile.mkstemp(dir=parent, prefix=".tmp-auth-", suffix=".json")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_path, mode)
        os.replace(temp_path, path)
        path.chmod(mode)
    except Exception:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def write_back_auth_files(agent_home, session_home, profile, launch_snapshots, state_dir=None):
    """Write refreshed auth files back into the dedicated home (option a).

    Under the state lock, copy each profile auth file from the session home only
    when it is valid JSON with the expected shape and is newer or different from
    the launch snapshot. Never follows symlinks; final mode is 0600.
    """
    agent_home = Path(agent_home)
    session_home = Path(session_home)
    written = []
    with StateLock(state_dir):
        for name in profile.auth_files:
            src = session_home / name
            dest = agent_home / name
            if src.is_symlink() or dest.is_symlink():
                continue
            if not src.is_file():
                continue
            try:
                payload = src.read_bytes()
                data = json.loads(payload.decode("utf-8"))
            except (OSError, UnicodeDecodeError, json.JSONDecodeError):
                continue
            if not profile.validate_auth_data(data):
                continue
            snap = launch_snapshots.get(name)
            if snap is not None and payload == snap["data"]:
                continue
            try:
                _atomic_write_bytes(dest, payload, mode=0o600)
            except (OSError, ValueError):
                continue
            written.append(name)
    return written


def _container_missing(result):
    detail = f"{result.stderr}\n{result.stdout}".lower()
    return (
        "no such container" in detail
        or "no container with name or id" in detail
        or bool(re.search(r"container[^\n]*(?:does not exist|not found)", detail))
    )


def remove_worker_container(worker_id):
    """Force-remove a worker container, tolerating an already absent container."""
    validate_worker_id(worker_id)
    result = run("podman", "rm", "-f", f"herdr-{worker_id}")
    if result.returncode and not _container_missing(result):
        detail = result.stderr.strip() or result.stdout.strip() or "unknown Podman error"
        raise ValueError(f"Unable to remove worker container herdr-{worker_id}: {detail}.")


def parse_duration(value, setting_name="[gc].max_age"):
    """Parse a compact duration like 7d, 12h, 30m, or 90s into seconds."""
    if not isinstance(value, str) or not value.strip():
        raise ValueError(f"Set {setting_name} to a nonempty duration such as '7d'.")
    match = DURATION_RE.fullmatch(value.strip())
    if not match:
        raise ValueError(
            f"Set {setting_name} to a positive duration with unit s, m, h, or d "
            f"(for example '7d'); got {value!r}."
        )
    amount, unit = match.groups()
    return int(amount) * DURATION_UNITS[unit]


def gc_settings(config_dir):
    """Load the optional [gc] table; default max_age is 7d."""
    config_file = Path(config_dir) / "config.toml"
    if not config_file.is_file():
        return {"max_age": DEFAULT_GC_MAX_AGE, "max_age_seconds": parse_duration(DEFAULT_GC_MAX_AGE)}
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("gc", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [gc] table in {config_file}.")
    _permitted_settings(options, "[gc]", {"max_age"})
    max_age = options.get("max_age", DEFAULT_GC_MAX_AGE)
    return {"max_age": max_age, "max_age_seconds": parse_duration(max_age)}


def _herdr_bin():
    if "HERDR_BIN_PATH" in os.environ:
        herdr = Path(os.environ["HERDR_BIN_PATH"]).expanduser().resolve()
        if herdr.is_file():
            return str(herdr)
    found = shutil.which("herdr")
    if found:
        return found
    return None


def _structured_pane_not_found(payload):
    return (
        isinstance(payload, dict)
        and isinstance(payload.get("error"), dict)
        and payload["error"].get("code") == "pane_not_found"
    )


def pane_exists(pane_id):
    """Return True/False when pane existence is known; None when it cannot be determined.

    Uses `herdr pane get <pane_id>` (verified in docs/herdr-pane-lifecycle.md).
    Only a structured JSON error with code ``pane_not_found`` means the pane is
    gone. Substrings like "not found" (command missing, socket down, etc.) are
    treated as unknown so GC never deletes on a soft failure.
    """
    if not isinstance(pane_id, str) or not pane_id.strip():
        return False
    herdr = _herdr_bin()
    if herdr is None:
        return None
    result = run(herdr, "pane", "get", pane_id.strip())
    stdout = (result.stdout or "").strip()
    stderr = (result.stderr or "").strip()
    saw_json = False
    for raw in (stdout, stderr):
        if not raw:
            continue
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            continue
        saw_json = True
        if _structured_pane_not_found(payload):
            return False
        if isinstance(payload, dict) and isinstance(payload.get("error"), dict):
            return None
        if result.returncode == 0 and isinstance(payload, dict):
            return True
    if result.returncode == 0 and not saw_json:
        # Successful non-JSON output: treat as present rather than guessing gone.
        return True
    return None


def _read_worker_metadata(worker_dir):
    metadata_path = worker_dir / "worker.json"
    try:
        with metadata_path.open() as stream:
            metadata = json.load(stream)
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Invalid worker metadata: {metadata_path}") from exc
    if not isinstance(metadata, dict):
        raise ValueError(f"Invalid worker metadata: {metadata_path}")
    return metadata


def _parse_created_at(value):
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        created = datetime.fromisoformat(text)
    except ValueError:
        return None
    if created.tzinfo is None:
        created = created.replace(tzinfo=timezone.utc)
    return created.astimezone(timezone.utc)


def _worker_container_running(worker_id):
    """True only when Podman reports an actively running worker container."""
    return container_status(worker_id) == "running"


GC_COLLECTIBLE_CONTAINER_STATUSES = frozenset({"not-found", "exited", "stopped"})


def _container_status_collectible(status):
    """Fail closed: GC may delete only when the container is clearly absent or stopped."""
    return status in GC_COLLECTIBLE_CONTAINER_STATUSES


def _delete_worker_directory(worker_dir, workers_dir):
    """Delete one worker directory after refusing symlinks and path escapes."""
    workers_root = Path(workers_dir).resolve()
    candidate = Path(worker_dir)
    if candidate.is_symlink():
        raise ValueError(f"Worker path is not a real directory inside plugin workers: {candidate}")
    if not candidate.exists():
        return False
    if not candidate.is_dir():
        raise ValueError(f"Worker path is not a directory: {candidate}")
    resolved = candidate.resolve()
    if not resolved.is_relative_to(workers_root):
        raise ValueError(f"Worker path escapes plugin workers directory: {candidate}")
    if resolved == workers_root:
        raise ValueError(f"Refusing to delete the workers directory itself: {candidate}")
    # Refuse if any path component under workers_root is a symlink.
    try:
        relative = resolved.relative_to(workers_root)
    except ValueError as exc:
        raise ValueError(f"Worker path escapes plugin workers directory: {candidate}") from exc
    current = workers_root
    for part in relative.parts:
        current = current / part
        if current.is_symlink():
            raise ValueError(f"Worker path contains a symlink: {current}")
    shutil.rmtree(resolved)
    return True


def destroy_worker(worker_id, state_dir=None, force=False, warn_unfetched=False):
    """Stop/remove a worker container, then remove only that worker's storage.

    Without force, refuse when the worker container is running. Optionally warn
    when the result was never fetched (status is not 'fetched').
    """
    workers_dir, worker_dir = worker_storage(worker_id, state_dir)
    if worker_dir.exists() and warn_unfetched:
        try:
            metadata = _read_worker_metadata(worker_dir)
            if metadata.get("status") != "fetched":
                print(
                    f"Warning: worker {worker_id} result was never fetched "
                    f"(status={metadata.get('status', 'unknown')}).",
                    file=sys.stderr,
                )
        except ValueError:
            print(
                f"Warning: worker {worker_id} metadata is unreadable; removing anyway.",
                file=sys.stderr,
            )
    if not force and worker_dir.exists() and _worker_container_running(worker_id):
        raise ValueError(
            f"Worker {worker_id} has a running container. Pass --force to remove it."
        )
    remove_worker_container(worker_id)
    if not worker_dir.exists():
        return False
    return _delete_worker_directory(worker_dir, workers_dir)


def parse_plugin_event_json(raw):
    """Strictly parse HERDR_PLUGIN_EVENT_JSON for a pane.closed payload."""
    if not isinstance(raw, str) or not raw.strip():
        raise ValueError("HERDR_PLUGIN_EVENT_JSON is missing or empty.")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError(f"Invalid HERDR_PLUGIN_EVENT_JSON: {exc}.") from exc
    if not isinstance(payload, dict):
        raise ValueError("HERDR_PLUGIN_EVENT_JSON must be a JSON object.")
    event = payload.get("event")
    data = payload.get("data")
    if event != "pane_closed":
        raise ValueError(
            f"HERDR_PLUGIN_EVENT_JSON event must be 'pane_closed', got {event!r}."
        )
    if not isinstance(data, dict):
        raise ValueError("HERDR_PLUGIN_EVENT_JSON data must be an object.")
    if data.get("type") not in {None, "pane_closed"}:
        raise ValueError(
            f"HERDR_PLUGIN_EVENT_JSON data.type must be 'pane_closed', got {data.get('type')!r}."
        )
    pane_id = data.get("pane_id")
    if not isinstance(pane_id, str) or not pane_id.strip():
        raise ValueError("HERDR_PLUGIN_EVENT_JSON data.pane_id must be a nonempty string.")
    return pane_id.strip()


def _iter_worker_dirs(state_dir=None):
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.is_dir() or workers_dir.is_symlink():
        return workers_dir, []
    entries = []
    for entry in sorted(workers_dir.iterdir(), key=lambda path: path.name):
        if entry.is_symlink() or not entry.is_dir() or not WORKER_ID_RE.fullmatch(entry.name):
            continue
        entries.append(entry)
    return workers_dir, entries


def _worker_is_stale(metadata, max_age_seconds, now=None):
    created = _parse_created_at(metadata.get("created_at"))
    if created is None:
        return False
    now = now or datetime.now(timezone.utc)
    return (now - created) >= timedelta(seconds=max_age_seconds)


def _pane_gone_for_gc(metadata):
    """Whether the worker's pane is gone for fetched-pane GC.

    Null pane_id means no Herdr pane was recorded (popup / non-Herdr); treat as gone.
    When the existence query is inconclusive, do not guess — keep the worker.
    """
    pane_id = metadata.get("pane_id")
    if pane_id is None or (isinstance(pane_id, str) and not pane_id.strip()):
        return True
    if not isinstance(pane_id, str):
        return False
    exists = pane_exists(pane_id)
    if exists is None:
        return False
    return not exists


def _try_fetch_before_gc(worker_id, state_dir, warnings):
    """Attempt fetch for max_age GC; return True only when fetch succeeds."""
    try:
        fetch_worker(worker_id, state_dir)
        return True
    except (ValueError, OSError) as exc:
        warnings.append(
            f"Skipping unfetched worker {worker_id}: fetch before GC failed ({exc})."
        )
        return False


def _source_sandbox_commit(source_repo, worker_id):
    """Read refs/heads/sandbox/<id> from the source repo (host git on source only)."""
    source = Path(source_repo).expanduser().resolve()
    result = run(
        "git",
        "-C",
        str(source),
        "rev-parse",
        "--verify",
        "--end-of-options",
        f"refs/heads/sandbox/{worker_id}^{{commit}}",
    )
    if result.returncode:
        return None
    sha = (result.stdout or "").strip()
    if not re.fullmatch(r"[0-9a-fA-F]{40}", sha):
        return None
    return sha


def _tip_matches_fetched(worker_id, worker_dir, metadata):
    """True when agent/<id> tip and source sandbox/<id> both equal fetched_commit."""
    fetched = metadata.get("fetched_commit")
    if not isinstance(fetched, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", fetched):
        return False
    repo = Path(worker_dir) / "repo"
    try:
        tip = _safe_read_worker_ref(repo, f"agent/{worker_id}")
    except ValueError:
        return False
    if tip is None or tip.lower() != fetched.lower():
        return False
    source = metadata.get("source_repo")
    if not isinstance(source, str) or not source:
        return False
    sandbox = _source_sandbox_commit(source, worker_id)
    return sandbox is not None and sandbox.lower() == fetched.lower()


def _prepare_worker_for_collection(worker_id, worker_dir, metadata, *, allow_fetch, state_dir, warnings):
    """Require a current fetch before GC deletion.

    Status ``fetched`` alone is not enough: the worker may have kept committing.
    Compare ``agent/<id>`` and ``refs/heads/sandbox/<id>`` to ``fetched_commit``.
    On mismatch, explicit GC may re-fetch; event/opportunistic paths skip.
    """
    if metadata.get("status") != "fetched":
        return False, metadata
    if _tip_matches_fetched(worker_id, worker_dir, metadata):
        return True, metadata
    if not allow_fetch:
        warnings.append(
            f"Skipping worker {worker_id}: tip moved since last fetch "
            "(status is fetched but agent tip or sandbox ref does not match fetched_commit)."
        )
        return False, metadata
    if not _try_fetch_before_gc(worker_id, state_dir, warnings):
        return False, metadata
    try:
        metadata = _read_worker_metadata(worker_dir)
    except ValueError as exc:
        warnings.append(f"Skipping worker {worker_id}: {exc}")
        return False, metadata
    if metadata.get("status") != "fetched" or not _tip_matches_fetched(worker_id, worker_dir, metadata):
        warnings.append(
            f"Skipping worker {worker_id}: re-fetch did not leave tip matching sandbox/{worker_id}."
        )
        return False, metadata
    return True, metadata


def gc_collect_workers(
    state_dir=None,
    config_dir=None,
    pane_id=None,
    opportunistic=False,
    allow_fetch=None,
    deadline=None,
    now=None,
):
    """Collect eligible workers without rewriting refs in any source repository.

    max_age rule for unfetched workers (explicit ``hs gc`` only): attempt fetch
    first; delete only on success; otherwise skip with a one-line warning.
    Opportunistic and pane-event paths never fetch; they leave stale unfetched
    workers for explicit ``hs gc``.
    """
    removed = []
    warnings = []
    skipped = []
    now = now or datetime.now(timezone.utc)
    if allow_fetch is None:
        allow_fetch = not opportunistic and pane_id is None
    if config_dir is None:
        config_dir, _ = paths()
    settings = gc_settings(config_dir)
    max_age_seconds = settings["max_age_seconds"]
    workers_dir, entries = _iter_worker_dirs(state_dir)

    for entry in entries:
        if deadline is not None and time.monotonic() >= deadline:
            warnings.append("GC budget exhausted; remaining workers left for later.")
            break
        worker_id = entry.name
        try:
            metadata = _read_worker_metadata(entry)
        except ValueError as exc:
            warnings.append(f"Skipping worker {worker_id}: {exc}")
            continue
        if pane_id is not None:
            recorded = metadata.get("pane_id")
            if recorded != pane_id:
                continue
            # Event / --pane path: only fetched workers for that pane.
            if metadata.get("status") != "fetched":
                skipped.append(worker_id)
                continue
        else:
            status = metadata.get("status")
            fetched_and_pane_gone = status == "fetched" and _pane_gone_for_gc(metadata)
            stale = _worker_is_stale(metadata, max_age_seconds, now=now)
            if not fetched_and_pane_gone and not stale:
                continue
            if stale and status != "fetched":
                if not allow_fetch:
                    warnings.append(
                        f"Skipping unfetched worker {worker_id}: "
                        "leave fetch-before-GC to explicit hs gc."
                    )
                    skipped.append(worker_id)
                    continue
                if not _try_fetch_before_gc(worker_id, state_dir, warnings):
                    continue
                try:
                    metadata = _read_worker_metadata(entry)
                except ValueError as exc:
                    warnings.append(f"Skipping worker {worker_id}: {exc}")
                    continue
                if metadata.get("status") != "fetched":
                    warnings.append(
                        f"Skipping unfetched worker {worker_id}: fetch did not mark status fetched."
                    )
                    continue

        ready, metadata = _prepare_worker_for_collection(
            worker_id,
            entry,
            metadata,
            allow_fetch=allow_fetch,
            state_dir=state_dir,
            warnings=warnings,
        )
        if not ready:
            skipped.append(worker_id)
            continue

        container = container_status(worker_id)
        if not _container_status_collectible(container):
            skipped.append(worker_id)
            warnings.append(
                f"Skipping worker {worker_id}: container status {container!r} "
                "is not safely collectible."
            )
            continue
        try:
            if destroy_worker(worker_id, state_dir=state_dir, force=True, warn_unfetched=False):
                removed.append(worker_id)
            else:
                skipped.append(worker_id)
        except ValueError as exc:
            warnings.append(f"Skipping worker {worker_id}: {exc}")
    return {"removed": removed, "warnings": warnings, "skipped": skipped, "workers_dir": str(workers_dir)}


def opportunistic_gc(state_dir=None, config_dir=None):
    """Best-effort GC at launch: non-blocking lock, no fetch, time-bounded, never raise."""
    try:
        if state_dir is None or config_dir is None:
            config_dir, state_dir = paths()
        deadline = time.monotonic() + GC_OPPORTUNISTIC_BUDGET_SECONDS
        try:
            with StateLock(state_dir, blocking=False):
                if time.monotonic() >= deadline:
                    return {
                        "removed": [],
                        "warnings": ["Opportunistic GC skipped: budget exhausted before work."],
                        "skipped": [],
                    }
                result = gc_collect_workers(
                    state_dir=state_dir,
                    config_dir=config_dir,
                    opportunistic=True,
                    allow_fetch=False,
                    deadline=deadline,
                )
        except BlockingIOError:
            message = "Opportunistic GC skipped: state lock busy."
            print(message, file=sys.stderr)
            return {"removed": [], "warnings": [message], "skipped": []}
        for warning in result["warnings"]:
            print(warning, file=sys.stderr)
        if result["removed"]:
            print(
                f"Opportunistic GC removed: {', '.join(result['removed'])}",
                file=sys.stderr,
            )
        return result
    except Exception as exc:  # noqa: BLE001 - launch must not fail because of GC
        print(f"Opportunistic GC skipped: {exc}", file=sys.stderr)
        return {"removed": [], "warnings": [str(exc)], "skipped": []}


def sweep_stale_agent_sessions(agent_home, max_age_seconds=None, state_dir=None, profile=None):
    """Remove leftover per-launch session homes under <agent home>/sessions/.

    Live sessions are those whose name is prefixed by a worker ID whose
    container is still running. Leftovers older than the oldest live session
    (or older than max_age when none are live) are removed. Symlinks are refused
    and deletion stays confined to the sessions directory.
    """
    profile = DEFAULT_PROFILE if profile is None else profile
    agent_home = Path(agent_home).expanduser().resolve()
    sessions_dir = agent_home / "sessions"
    if sessions_dir.is_symlink():
        raise ValueError(f"{profile.name} session storage is not a real directory: {sessions_dir}.")
    if not sessions_dir.exists():
        return []
    if not sessions_dir.is_dir():
        raise ValueError(f"{profile.name} session storage is not a real directory: {sessions_dir}.")
    sessions_root = sessions_dir.resolve()
    if not sessions_root.is_relative_to(agent_home):
        raise ValueError(f"{profile.name} sessions directory escapes agent home: {sessions_dir}.")

    if max_age_seconds is None:
        try:
            config_dir, _ = paths()
            max_age_seconds = gc_settings(config_dir)["max_age_seconds"]
        except ValueError:
            max_age_seconds = parse_duration(DEFAULT_GC_MAX_AGE)

    _, worker_dirs = _iter_worker_dirs(state_dir)
    worker_ids = [entry.name for entry in worker_dirs]

    def _owner_worker_id(session_name):
        matches = [worker_id for worker_id in worker_ids if session_name.startswith(f"{worker_id}-")]
        if not matches:
            return None
        return max(matches, key=len)

    live = []
    leftovers = []
    for entry in sessions_dir.iterdir():
        if entry.is_symlink() or not entry.is_dir():
            continue
        try:
            resolved = entry.resolve()
        except OSError:
            continue
        if not resolved.is_relative_to(sessions_root) or resolved == sessions_root:
            continue
        owner = _owner_worker_id(entry.name)
        if owner is not None and _worker_container_running(owner):
            live.append(entry)
        else:
            leftovers.append(entry)

    if live:
        cutoff = min(path.stat().st_mtime for path in live)
    else:
        cutoff = time.time() - max_age_seconds

    removed = []
    for entry in leftovers:
        try:
            if entry.is_symlink() or not entry.is_dir():
                continue
            if entry.stat().st_mtime >= cutoff:
                continue
            resolved = entry.resolve()
            if not resolved.is_relative_to(sessions_root) or resolved == sessions_root:
                continue
            cursor = sessions_root
            safe = True
            for part in resolved.relative_to(sessions_root).parts:
                cursor = cursor / part
                if cursor.is_symlink():
                    safe = False
                    break
            if not safe:
                continue
            shutil.rmtree(resolved)
            removed.append(entry.name)
        except OSError:
            continue
    return removed


def fetch_options(config_dir):
    """Read the fixed worker ID used by the non-prompting fetch action."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("fetch", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [fetch] table in {config_file}.")
    if "id" in options and not isinstance(options["id"], str):
        raise ValueError(f"Set [fetch].id to a string in {config_file}.")
    return options


def sole_worker_id(state_dir=None):
    """Return the only persisted worker, or None when selection is ambiguous."""
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.is_dir() or workers_dir.is_symlink():
        return None
    worker_ids = sorted(
        entry.name for entry in workers_dir.iterdir()
        if entry.is_dir() and not entry.is_symlink() and WORKER_ID_RE.fullmatch(entry.name)
    )
    return worker_ids[0] if len(worker_ids) == 1 else None


def configured_or_sole_worker(worker_id, config_dir, option_loader, action):
    """Prefer explicit/configured selection; make the one-worker path config-free."""
    if worker_id:
        return worker_id
    configured = option_loader(config_dir).get("id")
    if configured:
        return configured
    _, state_dir = paths()
    selected = sole_worker_id(state_dir)
    if selected:
        return selected
    raise ValueError(
        f"Worker ID is required when there is not exactly one worker. "
        f"Pass `{action} --id WORKER_ID` or set the action's id in the plugin config."
    )


def workspace_sole_worker_id(workspace, state_dir=None):
    """Return the only worker in the given workspace, or None when ambiguous.

    Invalid worker entries are ignored so a single valid worker in scope still
    resolves. When workspace is None, any valid worker qualifies (direct-launcher
    use without Herdr context).
    """
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.is_dir() or workers_dir.is_symlink():
        return None
    candidates = []
    for entry in workers_dir.iterdir():
        if not entry.is_dir() or entry.is_symlink() or not WORKER_ID_RE.fullmatch(entry.name):
            continue
        if workspace is not None:
            try:
                source = worker_source_repo(entry.name, state_dir)
            except ValueError:
                continue
            if source != workspace:
                continue
        candidates.append(entry.name)
    return candidates[0] if len(candidates) == 1 else None


def _require_open_worker_id(reason):
    raise ValueError(
        f"Worker ID is required when {reason}. "
        "Pass `--id WORKER_ID` or set [open].id in the plugin config."
    )


def resolve_open_worker(worker_id, config_dir):
    """Resolve the worker for an interactive open, scoping fallback to the workspace.

    Explicit IDs and configured [open].id are validated against the current
    workspace; the sole-worker fallback only considers workers that belong to
    that workspace. This keeps an unrelated worker in another workspace from
    being selected when no ID is supplied, and ensures no pane is created when
    the context is stale, missing, or ambiguous.
    """
    if worker_id:
        validate_open_context(worker_id)
        return worker_id
    configured = open_options(config_dir).get("id")
    if configured:
        validate_open_context(configured)
        return configured
    _, state_dir = paths()
    workspace = context_repo_root()
    selected = workspace_sole_worker_id(workspace, state_dir)
    if selected:
        validate_open_context(selected)
        return selected
    if workspace is not None:
        _require_open_worker_id("the current workspace has no sandbox worker")
    _require_open_worker_id("there is not exactly one worker")


def fetch_worker(worker_id, state_dir=None):
    """Fetch a worker branch into its source repository for later review.

    Imports the worker tip (refs/heads/agent/<id>) into
    refs/heads/sandbox/<id> via a verified git bundle built from copied objects
    in a temporary bare repo. Host git never uses the worker clone as cwd or -C,
    so worker .git/config is never read. The source repository is unchanged until
    the final bundle fetch succeeds.

    Worker ref choice: agent/<id>, not HEAD. create_worker always creates that
    branch for the worker tip; reading the named ref via confined files matches
    the safe import path and avoids ambiguous detached-HEAD tips.

    Zero commits: the sandbox/<id> ref is still created (pointing at the same
    tip as base) so review commands and GC status stay predictable.

    If the source HEAD has moved past the worker's base commit, a notice is
    included but the fetch still proceeds as-is. If sandbox/<id> is checked out
    in any worktree, fetch fails before touching the source and leaves the
    worker un-fetched.
    """
    _, worker_dir = worker_storage(worker_id, state_dir)
    repo = worker_dir / "repo"
    metadata_path = worker_dir / "worker.json"
    if not repo.is_dir() or repo.is_symlink():
        raise ValueError(f"Worker repository is missing: {repo}")
    try:
        with metadata_path.open() as stream:
            metadata = json.load(stream)
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"Invalid worker metadata: {metadata_path}") from exc
    if not isinstance(metadata, dict) or not isinstance(metadata.get("source_repo"), str):
        raise ValueError(f"Invalid worker metadata: {metadata_path}")
    source = Path(metadata["source_repo"]).expanduser().resolve()
    source_error = check_source(source)
    if source_error:
        raise ValueError(source_error)
    source = Path(git("-C", source, "rev-parse", "--show-toplevel")).resolve()
    branch = f"agent/{validate_worker_id(worker_id)}"
    sandbox_branch = validate_sandbox_result_branch(f"sandbox/{worker_id}")
    base_commit = metadata.get("base_commit")
    if not isinstance(base_commit, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", base_commit):
        raise ValueError(f"Worker metadata has no valid base commit: {metadata_path}")

    checkout_path = _sandbox_branch_checkout_path(source, sandbox_branch)
    if checkout_path is not None:
        raise ValueError(
            f"sandbox/{worker_id} is checked out in {checkout_path}; "
            f"switch away and run `hs fetch {worker_id}`"
        )

    current_head = git("-C", source, "rev-parse", "HEAD")
    head_moved = current_head != base_commit

    try:
        _safe_fetch_from_worker(source, repo, branch, sandbox_branch)
    except ValueError as exc:
        raise ValueError(f"Failed to fetch worker branch: {exc}") from exc

    # Counts and diffs are computed only in the source repo against the fetched ref.
    commit = git("-C", source, "rev-parse", "--verify", f"refs/heads/{sandbox_branch}^{{commit}}")
    commit_count = int(git("-C", source, "rev-list", "--count", f"{base_commit}..{sandbox_branch}"))
    log_oneline = git(
        "-C", source, "log", "--oneline", "--no-decorate", "-n", "10",
        f"{base_commit}..{sandbox_branch}",
    )
    changed_files = [
        name for name in git(
            "-C", source, "diff", "--no-ext-diff", "--name-only",
            f"{base_commit}...{sandbox_branch}",
        ).splitlines() if name
    ]
    diff_stat = git("-C", source, "diff", "--no-ext-diff", "--stat", f"{base_commit}...{sandbox_branch}")

    dirty_warning = None
    snapshot = _query_worker_git_snapshot(worker_id, base_commit=base_commit)
    if snapshot.get("error") is None and snapshot.get("status_porcelain"):
        dirty_warning = (
            "Warning: the worker has uncommitted changes that are not included "
            "in this result."
        )

    _update_worker_metadata(worker_dir, {
        "status": "fetched",
        "result_branch": sandbox_branch,
        "fetched_commit": commit,
    })

    result = {
        "commit": commit,
        "branch": sandbox_branch,
        "commit_count": commit_count,
        "log_oneline": log_oneline,
        "changed_files": changed_files,
        "diff_stat": diff_stat,
        "base_commit": base_commit,
        "current_head": current_head,
        "head_moved": head_moved,
        "source_repo": str(source),
        "worker_id": worker_id,
        # Reused by execute_worker so post-run accounting does not query twice.
        "git_snapshot": snapshot,
    }
    if dirty_warning:
        result["dirty_warning"] = dirty_warning
    if head_moved:
        result["head_moved_notice"] = (
            f"Notice: source HEAD has moved from {base_commit[:12]} to {current_head[:12]}. "
            f"The worker result is based on the original base commit."
        )
    return result


def _review_git_commands(source_repo, base, worker_id):
    """Build quoted ``git -C <source>`` review commands for ``sandbox/<id>``.

    Always targets a validated ``sandbox/<id>`` branch (never unchecked
    ``result_branch`` metadata). Quotes every shell-sensitive argument.
    """
    worker_id = validate_worker_id(worker_id)
    branch = validate_sandbox_result_branch(f"sandbox/{worker_id}")
    quoted_source = shlex.quote(str(source_repo))
    quoted_base = shlex.quote(str(base))
    quoted_branch = shlex.quote(branch)
    return (
        branch,
        [
            f"  git -C {quoted_source} log {quoted_base}..{quoted_branch}",
            f"  git -C {quoted_source} diff {quoted_base}...{quoted_branch}",
        ],
        quoted_source,
        quoted_branch,
    )


def format_fetch_result(result):
    """Format the fetched branch, commit count, and plain-git review commands."""
    worker_id = result.get("worker_id")
    if not worker_id:
        branch = result.get("branch") or ""
        if isinstance(branch, str) and branch.startswith("sandbox/"):
            worker_id = branch[len("sandbox/"):]
        else:
            raise ValueError("Fetch result is missing worker_id for review commands.")
    source_repo = result.get("source_repo")
    if not isinstance(source_repo, str) or not source_repo:
        raise ValueError("Fetch result is missing source_repo for review commands.")
    files = "\n".join(result["changed_files"]) or "(none)"
    stat = result["diff_stat"] or "(no changes)"
    count = result.get("commit_count")
    count_line = f"Commits: {count}" if count is not None else "Commits: -"
    base = result.get("base_commit") or "BASE"
    base_short = base[:12] if isinstance(base, str) and len(base) >= 12 else base
    branch, review_cmds, quoted_source, quoted_branch = _review_git_commands(
        source_repo, base_short, worker_id
    )
    lines = [
        f"Branch: {branch}",
        count_line,
        f"Commit: {result['commit']}",
    ]
    if result.get("dirty_warning"):
        lines.append(result["dirty_warning"])
    if result.get("head_moved_notice"):
        lines.append(result["head_moved_notice"])
    log_oneline = (result.get("log_oneline") or "").strip()
    if log_oneline:
        lines.extend(["Log:", log_oneline])
    elif count == 0:
        lines.append("Log: (no commits beyond base; sandbox ref still created)")
    lines.extend([
        "Review:",
        *review_cmds,
        "Integrate:",
        f"  git -C {quoted_source} merge {quoted_branch}",
        "  # or rebase onto that branch / apply selected commits",
        "Changed files:",
        files,
        "Diff stat:",
        stat,
    ])
    return "\n".join(lines)


def warn_deprecated_integration_config(config_dir):
    """Ignore legacy config tables with a one-line notice (never an error)."""
    config_file = Path(config_dir) / "config.toml"
    if not config_file.is_file():
        return
    try:
        with config_file.open("rb") as stream:
            config = tomllib.load(stream)
    except (OSError, tomllib.TOMLDecodeError):
        return
    if "cherry_pick" in config:
        print(
            "Note: [cherry_pick] is deprecated and ignored; integrate with plain git on sandbox/<id>.",
            file=sys.stderr,
        )
    if "inspect" in config:
        print(
            "Note: [inspect] is deprecated and ignored; pass `inspect WORKER_ID` "
            "or run `hs inspect` in the worker's pane.",
            file=sys.stderr,
        )
    if "execute" in config:
        print(
            f'Note: [execute] is deprecated and ignored; use `hs {DEFAULT_PROFILE.name} --prompt "..."`.',
            file=sys.stderr,
        )


def open_options(config_dir):
    """Read the fixed worker chosen by the non-prompting Herdr open action."""
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("open", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected an [open] table in {config_file}.")
    if "id" in options and not isinstance(options["id"], str):
        raise ValueError(f"Set [open].id to a string in {config_file}.")
    return options


def _write_worker_status(worker_dir, status):
    _update_worker_metadata(worker_dir, {"status": status})


def _update_worker_metadata(worker_dir, updates):
    metadata_path = worker_dir / "worker.json"
    with metadata_path.open() as stream:
        metadata = json.load(stream)
    if not isinstance(metadata, dict):
        raise ValueError(f"Invalid worker metadata: {metadata_path}")
    metadata.update(updates)
    _atomic_write_json(metadata_path, metadata)


class PodmanSandboxRuntime:
    """The single owner of the Podman worker isolation contract.

    Isolation flags (userns, capabilities, read-only root, network policy,
    resource limits, workspace mount, tmp homes) are fixed here. A profile may
    only supply agent-specific env, home mount, and argv values — never network
    access, devices, capabilities, or extra mounts.
    """

    def __init__(self, worker_id, image, repo, agent_home, network, cpus, memory, pids, profile):
        self.worker_id = worker_id
        self.image = image
        self.repo = repo
        self.agent_home = agent_home
        self.network = network
        self.cpus = cpus
        self.memory = memory
        self.pids = pids
        self.profile = profile

    def _base_command(self, interactive=False):
        """Build the shared hardened Podman invocation for both execution modes."""
        profile = self.profile
        invocation = [
            "podman", "run", "--rm",
            "--userns=keep-id", "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
            f"--pids-limit={self.pids}", f"--memory={self.memory}", f"--cpus={self.cpus}",
            "--env", "HOME=/tmp/home",
            "--env", f"{profile.home_env_var}={profile.mount_point}",
            "--env", "XDG_CACHE_HOME=/tmp/cache",
            "--mount", f"type=bind,src={self.repo.resolve()},dst=/workspace,rw",
            "--mount", f"type=bind,src={self.agent_home.resolve()},dst={profile.mount_point},rw",
            "--workdir", "/workspace",
        ]
        if interactive:
            invocation.insert(3, "-it")
        invocation.insert(4 if interactive else 3, "--name")
        invocation.insert(5 if interactive else 4, f"herdr-{self.worker_id}")
        if self.network == "offline":
            invocation.append("--network=none")
        return invocation

    def git_query_command(self, *container_argv):
        """Build a one-shot query invocation that cannot collide with the session.

        Unlike `_base_command`, this has no `--name herdr-<id>`, forces
        `--network=none`, mounts the workspace read-only, and never mounts the
        agent home or sets the agent home env var.
        """
        if not container_argv or any(not isinstance(arg, str) or not arg for arg in container_argv):
            raise ValueError("Query command must contain nonempty arguments.")
        return [
            "podman", "run", "--rm",
            "--userns=keep-id", "--cap-drop=ALL", "--security-opt=no-new-privileges", "--read-only",
            f"--pids-limit={self.pids}", f"--memory={self.memory}", f"--cpus={self.cpus}",
            "--network=none",
            "--env", "HOME=/tmp/home",
            "--env", "XDG_CACHE_HOME=/tmp/cache",
            "--env", "GIT_OPTIONAL_LOCKS=0",
            "--mount", f"type=bind,src={self.repo.resolve()},dst=/workspace,ro",
            "--workdir", "/workspace",
            self.image,
            *container_argv,
        ]

    def interactive_command(self, command=None, fresh=False):
        args = list(command or ["bash"])
        if not args or any(not isinstance(arg, str) or not arg for arg in args):
            raise ValueError("Interactive command must contain nonempty arguments.")
        if fresh:
            args = self.profile.build_interactive_argv(args)
        return self._base_command(interactive=True) + [self.image] + args

    def noninteractive_command(self, prompt):
        return self._base_command() + [self.image] + self.profile.build_noninteractive_argv(prompt)


def podman_runtime(worker_id, agent_home=None, profile=None):
    """Create the configured runtime only after validating its permitted paths."""
    profile = DEFAULT_PROFILE if profile is None else profile
    validate_worker_id(worker_id)
    config_dir, state_dir = paths()
    image, configured_home = load_config(config_dir, profile)
    network, cpus, memory, pids = runtime_settings(config_dir)
    _, worker_dir = worker_storage(worker_id, state_dir)
    repo = worker_dir / "repo"
    if not repo.is_dir() or repo.is_symlink() or not (repo / ".git").exists():
        raise ValueError(f"Worker repository does not exist: {repo}")
    selected_home = configured_home if agent_home is None else Path(agent_home).expanduser().resolve()
    if agent_home is not None and (
        selected_home == configured_home
        or not selected_home.is_relative_to(configured_home)
    ):
        raise ValueError(f"Fresh {profile.name} home must be inside the dedicated plugin home: {selected_home}")
    if not selected_home.is_dir() or selected_home.is_symlink():
        raise ValueError(f"Dedicated {profile.name} home does not exist: {selected_home}")
    return PodmanSandboxRuntime(
        worker_id, image, repo, selected_home, network, cpus, memory, pids, profile,
    )


def open_command(worker_id, command=None, fresh=False, agent_home=None, profile=None):
    """Build the central runtime's interactive invocation for a worker."""
    return podman_runtime(worker_id, agent_home, profile).interactive_command(command, fresh=fresh)


def execute_command(worker_id, prompt, agent_home=None, profile=None):
    """Build the shared runtime's noninteractive agent invocation for a worker.

    Callers that need the per-launch temp home (interactive and ``--prompt``)
    pass ``agent_home`` from ``fresh_agent_home``. Auth write-back after the
    session is handled by ``write_back_auth_files``.
    """
    return podman_runtime(worker_id, agent_home, profile).noninteractive_command(prompt)


def resolve_pane_placement(placement, target_pane, direction):
    """Validate and normalize a pane placement request.

    Herdr's plugin.pane.open API accepts placement and an optional
    target_pane_id. Herdr's CLI exposes this as --target-pane. This helper
    enforces one consistent contract for the plugin launcher: overlay targets
    the active pane and must not receive a target; split requires both a target
    pane and a direction; tab opens in a new tab and must not receive a target.
    """
    if placement is None:
        placement = "overlay"
    placement = placement.lower()
    if placement not in SUPPORTED_PANE_PLACEMENTS:
        raise ValueError(
            f"Unsupported placement '{placement}'. "
            f"Use one of: {', '.join(sorted(SUPPORTED_PANE_PLACEMENTS))}."
        )

    if placement in {"overlay", "tab"}:
        if target_pane is not None:
            raise ValueError(
                f"{placement} placement does not accept --target-pane. "
                "Use split with --target-pane and --direction."
            )
        if direction is not None:
            raise ValueError(
                f"{placement} placement does not accept --direction. "
                "Use split with --target-pane and --direction."
            )
        return placement, None, None

    if target_pane is None:
        raise ValueError(
            "split placement requires a target pane. "
            "Pass --target-pane PANE (for example, w1:p1) and --direction right|down."
        )
    if direction is None:
        raise ValueError(
            "split placement requires a direction. "
            "Pass --direction right or --direction down with --target-pane."
        )
    direction = direction.lower()
    if direction not in SPLIT_DIRECTIONS:
        raise ValueError(
            f"Unsupported split direction '{direction}'. "
            f"Use one of: {', '.join(sorted(SPLIT_DIRECTIONS))}."
        )
    return placement, target_pane, direction


def build_herdr_pane_open_command(placement, target_pane, direction):
    """Build the herdr plugin pane open invocation using the canonical CLI flag."""
    placement, target_pane, direction = resolve_pane_placement(placement, target_pane, direction)
    herdr_bin = os.environ.get("HERDR_BIN_PATH", "herdr")
    command = [
        herdr_bin, "plugin", "pane", "open",
        "--plugin", PLUGIN_ID,
        "--entrypoint", f"start-{DEFAULT_PROFILE.name}",
        "--placement", placement,
    ]
    if target_pane is not None:
        command.extend(["--target-pane", target_pane])
    if direction is not None:
        command.extend(["--direction", direction])
    return command


def open_worker(worker_id, command=None, fresh=False, profile=None):
    """Open a terminal-attached worker session for Herdr to manage."""
    profile = DEFAULT_PROFILE if profile is None else profile
    config_dir, state_dir = paths()
    _, worker_dir = worker_storage(worker_id, state_dir)
    validate_open_context(worker_id)
    command = list(command or ["bash"])
    needs_auth = bool(command) and command[0] == profile.interactive_bin
    errors = check(require_auth=needs_auth, profile=profile)
    if errors:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
    session_home = None
    launch_snapshots = None
    configured_home = None
    # Herdr reads HERDR_AGENT on the host wrapper, not inside the container.
    previous_herdr_agent = os.environ.get("HERDR_AGENT")
    try:
        if fresh:
            _, configured_home = load_config(config_dir, profile)
            session_home, launch_snapshots = fresh_agent_home(configured_home, worker_id, profile)
        invocation = open_command(
            worker_id, command, fresh=fresh, agent_home=session_home, profile=profile,
        )
        run_kwargs = {"check": False}
        if needs_auth or fresh:
            os.environ["HERDR_AGENT"] = profile.herdr_agent
            run_kwargs["env"] = profile.host_env()
        _write_worker_status(worker_dir, "running")
        try:
            result = subprocess.run(invocation, **run_kwargs)
        except BaseException:
            _write_worker_status(worker_dir, "failed")
            raise
        _write_worker_status(worker_dir, "stopped" if result.returncode == 0 else "failed")
        return result.returncode
    finally:
        if session_home is not None and launch_snapshots is not None and configured_home is not None:
            try:
                write_back_auth_files(
                    configured_home, session_home, profile, launch_snapshots, state_dir=state_dir,
                )
            except Exception as exc:  # noqa: BLE001 - session cleanup must proceed
                print(f"Auth write-back skipped: {exc}", file=sys.stderr)
            shutil.rmtree(session_home, ignore_errors=True)
        if previous_herdr_agent is None:
            os.environ.pop("HERDR_AGENT", None)
        else:
            os.environ["HERDR_AGENT"] = previous_herdr_agent



def _execution_run_paths(worker_dir):
    """Create an isolated durable directory for one noninteractive run."""
    runs_dir = worker_dir / "runs"
    runs_dir.mkdir(exist_ok=True)
    for _ in range(10):
        run_id = f"run-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')}-{uuid4().hex[:12]}"
        run_dir = runs_dir / run_id
        try:
            run_dir.mkdir()
        except FileExistsError:
            continue
        return run_id, run_dir / "result.json", run_dir / "output.log"
    raise ValueError(f"Unable to allocate a unique execution result directory in {runs_dir}.")


def _write_json(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def _start_execution_result(worker_dir, worker_id):
    run_id, result_path, log_path = _execution_run_paths(worker_dir)
    result = {
        "run_id": run_id,
        "worker_id": worker_id,
        "status": "running",
        "started_at": datetime.now(timezone.utc).isoformat(),
        "finished_at": None,
        "exit_status": None,
        "head": None,
        "dirty": None,
        "git_status": None,
        "result_branch": None,
        "commit_count": None,
        "result_location": str(result_path),
        "log_location": str(log_path),
        # Keep the original result field as an alias for callers of execute_worker.
        "output_location": str(log_path),
    }
    _write_json(result_path, result)
    _update_worker_metadata(worker_dir, {
        "latest_run_id": run_id,
        "latest_result": str(result_path.relative_to(worker_dir)),
    })
    return result, result_path, log_path


def _finish_execution_result(result, result_path, **updates):
    result.update(updates)
    _write_json(result_path, result)
    return result


def _emit_process_output(name, text, log_stream, output):
    if not text:
        return
    output[name].append(text)
    log_stream.write(text)
    log_stream.flush()
    destination = getattr(sys, name)
    destination.write(text)
    destination.flush()


def _stream_process(process, log_path):
    """Tee both child streams to the action and a durable log until exit."""
    output = {"stdout": [], "stderr": []}
    streams = {
        process.stdout: ("stdout", codecs.getincrementaldecoder("utf-8")(errors="replace")),
        process.stderr: ("stderr", codecs.getincrementaldecoder("utf-8")(errors="replace")),
    }
    selector = selectors.DefaultSelector()
    with log_path.open("w", encoding="utf-8") as log_stream:
        for stream in streams:
            selector.register(stream, selectors.EVENT_READ, stream)
        try:
            while selector.get_map():
                for key, _ in selector.select():
                    stream = key.fileobj
                    name, decoder = streams[stream]
                    chunk = os.read(stream.fileno(), 4096)
                    if chunk:
                        _emit_process_output(name, decoder.decode(chunk), log_stream, output)
                        continue
                    _emit_process_output(name, decoder.decode(b"", final=True), log_stream, output)
                    selector.unregister(stream)
                    stream.close()
        finally:
            selector.close()
    return process.wait(), {name: "".join(value) for name, value in output.items()}


def execute_worker(worker_id, prompt, profile=None):
    """Run one agent prompt with live output and a durable per-run result.

    Uses the same per-launch temp home as interactive mode. After the agent
    exits, auth files may be written back (option a), then the session home is
    removed. Fetch lands in ``sandbox/<id>``; post-run HEAD and commit count
    come from the source repository. Host git never uses the worker clone as
    cwd or ``-C``.
    """
    profile = DEFAULT_PROFILE if profile is None else profile
    config_dir, state_dir = paths()
    _, worker_dir = worker_storage(worker_id, state_dir)
    errors = check(require_auth=True, profile=profile)
    if errors:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
    _, configured_home = load_config(config_dir, profile)
    session_home, launch_snapshots = fresh_agent_home(configured_home, worker_id, profile)
    previous_herdr_agent = os.environ.get("HERDR_AGENT")
    os.environ["HERDR_AGENT"] = profile.herdr_agent
    host_env = profile.host_env()
    try:
        invocation = execute_command(worker_id, prompt, agent_home=session_home, profile=profile)
        _write_worker_status(worker_dir, "running")
        result_record, result_path, log_path = _start_execution_result(worker_dir, worker_id)
        process = None
        try:
            process = subprocess.Popen(
                invocation,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                close_fds=True,
                env=host_env,
            )
            exit_status, output = _stream_process(process, log_path)
        except BaseException as exc:
            if process is not None and process.poll() is None:
                process.kill()
                process.wait()
            error = f"{type(exc).__name__}: {exc}"
            log_path.parent.mkdir(parents=True, exist_ok=True)
            with log_path.open("a", encoding="utf-8") as log_stream:
                log_stream.write(f"\n[plugin error] {error}\n")
            _finish_execution_result(
                result_record,
                result_path,
                status="failed",
                finished_at=datetime.now(timezone.utc).isoformat(),
                error=error,
            )
            _write_worker_status(worker_dir, "failed")
            raise

        status = "completed" if exit_status == 0 else "failed"
        head_value = "unavailable"
        result_branch = None
        commit_count = None
        snapshot = None
        try:
            fetch_result = fetch_worker(worker_id, state_dir)
            head_value = fetch_result["commit"]
            result_branch = fetch_result["branch"]
            commit_count = fetch_result["commit_count"]
            snapshot = fetch_result.get("git_snapshot")
            if fetch_result.get("dirty_warning"):
                print(fetch_result["dirty_warning"], file=sys.stderr)
            if fetch_result.get("head_moved_notice"):
                print(fetch_result["head_moved_notice"], file=sys.stderr)
        except ValueError as exc:
            print(str(exc), file=sys.stderr)
            print(
                f"Worker {worker_id} was left un-fetched. "
                f"Switch away from sandbox/{worker_id} if it is checked out, then run: hs fetch {worker_id}",
                file=sys.stderr,
            )
            _write_worker_status(worker_dir, status)

        if snapshot is None:
            snapshot = _query_worker_git_snapshot(worker_id)
        if snapshot["error"]:
            git_status_value = f"(unavailable: {snapshot['error']})"
            dirty_value = None
        else:
            git_status_value = snapshot["status_short"]
            dirty_value = bool(snapshot["status_porcelain"])
        _finish_execution_result(
            result_record,
            result_path,
            status=status,
            finished_at=datetime.now(timezone.utc).isoformat(),
            exit_status=exit_status,
            head=head_value,
            dirty=dirty_value,
            git_status=git_status_value,
            result_branch=result_branch,
            commit_count=commit_count,
        )
        return {
            **result_record,
            "stdout": output["stdout"],
            "stderr": output["stderr"],
        }
    finally:
        try:
            write_back_auth_files(
                configured_home, session_home, profile, launch_snapshots, state_dir=state_dir,
            )
        except Exception as exc:  # noqa: BLE001
            print(f"Auth write-back skipped: {exc}", file=sys.stderr)
        shutil.rmtree(session_home, ignore_errors=True)
        if previous_herdr_agent is None:
            os.environ.pop("HERDR_AGENT", None)
        else:
            os.environ["HERDR_AGENT"] = previous_herdr_agent



def print_execution_result(result):
    """Print the final durable result summary after output was streamed live."""
    result_location = result.get("result_location", "-")
    log_location = result.get("log_location", result.get("output_location", "-"))
    result_branch = result.get("result_branch") or "-"
    commit_count = result.get("commit_count")
    commit_count_text = "-" if commit_count is None else str(commit_count)
    print(
        f"Worker: {result['worker_id']}\n"
        f"Run: {result.get('run_id', '-')}\n"
        f"Exit status: {result['exit_status']}\n"
        f"HEAD: {result['head']}\n"
        f"Result branch: {result_branch}\n"
        f"Commit count: {commit_count_text}\n"
        f"Dirty: {result['dirty']}\n"
        f"Git status: {result['git_status'] or 'clean'}\n"
        f"Result: {result_location}\n"
        f"Log: {log_location}"
    )


def _metadata_value(metadata, key, default="-"):
    value = metadata.get(key, default)
    return value if isinstance(value, str) and value else default


def _safe_read_worker_head(worker_repo):
    """Read HEAD from worker files without running git.

    Handles detached SHAs and symbolic refs via _safe_read_worker_ref (loose or
    packed-refs). Refuses symlinks. Returns (success, sha, error).
    """
    try:
        git_dir = _validate_worker_git_dir(worker_repo)
        head_file = git_dir / "HEAD"
        if head_file.is_symlink():
            return False, None, "HEAD is a symlink (not allowed)"
        if not head_file.is_file():
            return False, None, "HEAD file is missing"
        _confine_under(head_file, git_dir.resolve())
        head_content = head_file.read_text().strip()
    except (ValueError, OSError, UnicodeDecodeError) as exc:
        return False, None, str(exc)

    if head_content.startswith("ref: refs/heads/"):
        branch = head_content[len("ref: refs/heads/"):]
        try:
            sha = _safe_read_worker_ref(worker_repo, branch)
        except ValueError as exc:
            return False, None, str(exc)
        if sha is None:
            return False, None, f"Symbolic ref refs/heads/{branch} does not exist"
        return True, sha, ""
    if head_content.startswith("ref: "):
        return False, None, f"Unsupported HEAD symbolic ref: {head_content}"
    if not re.fullmatch(r"[0-9a-fA-F]{40}", head_content):
        return False, None, f"Invalid HEAD content: {head_content}"
    return True, head_content, ""


def _safe_read_worker_branch(worker_repo):
    """Read the current branch name from worker HEAD without running git.

    Returns (success, branch_or_none, error). branch is None for detached HEAD.
    """
    try:
        git_dir = _validate_worker_git_dir(worker_repo)
        head_file = git_dir / "HEAD"
        if head_file.is_symlink():
            return False, None, "HEAD is a symlink (not allowed)"
        if not head_file.is_file():
            return False, None, "HEAD file is missing"
        _confine_under(head_file, git_dir.resolve())
        head_content = head_file.read_text().strip()
    except (ValueError, OSError, UnicodeDecodeError) as exc:
        return False, None, str(exc)

    if head_content.startswith("ref: refs/heads/"):
        return True, head_content[len("ref: refs/heads/"):], ""
    if head_content.startswith("ref: "):
        return False, None, f"Unsupported HEAD symbolic ref: {head_content}"
    if re.fullmatch(r"[0-9a-fA-F]{40}", head_content):
        return True, None, ""
    return False, None, f"Invalid HEAD content: {head_content}"


WORKER_GIT_QUERY_MARKER = "HERDR_GIT_SECTION:"
WORKER_GIT_QUERY_SCRIPT = """\
marker="$1"
base="$2"
printf '%s%s\\n' "$marker" "STATUS_PORCELAIN"
git --no-optional-locks status --porcelain --untracked-files=all || true
printf '%s%s\\n' "$marker" "LOG"
git --no-optional-locks log --oneline --decorate -n 20 || true
printf '%s%s\\n' "$marker" "STATUS_SHORT"
git --no-optional-locks status --short --branch || true
printf '%s%s\\n' "$marker" "DIFF"
if [ -n "$base" ]; then
  git --no-optional-locks diff --no-ext-diff "$base...HEAD" || true
fi
"""


def build_worker_git_query_command(runtime, base_commit=None):
    """Return the hardened one-container git query command for a worker."""
    if base_commit is not None and (
        not isinstance(base_commit, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", base_commit)
    ):
        raise ValueError("base_commit must be a 40-character SHA when provided")
    return runtime.git_query_command(
        "sh", "-c", WORKER_GIT_QUERY_SCRIPT,
        "herdr-git-query",
        WORKER_GIT_QUERY_MARKER,
        base_commit or "",
    )


def _parse_worker_git_query_output(output):
    """Split one container query run into status/log/diff sections."""
    sections = {
        "status_porcelain": [],
        "log": [],
        "status_short": [],
        "diff": [],
    }
    current = None
    mapping = {
        f"{WORKER_GIT_QUERY_MARKER}STATUS_PORCELAIN": "status_porcelain",
        f"{WORKER_GIT_QUERY_MARKER}LOG": "log",
        f"{WORKER_GIT_QUERY_MARKER}STATUS_SHORT": "status_short",
        f"{WORKER_GIT_QUERY_MARKER}DIFF": "diff",
    }
    for line in (output or "").splitlines():
        if line in mapping:
            current = mapping[line]
            continue
        if current is not None:
            sections[current].append(line)
    return {key: "\n".join(value).strip() for key, value in sections.items()}


def _query_worker_git_snapshot(worker_id, base_commit=None):
    """Run status/log/diff for one worker in a single hardened container.

    Returns a dict with status_porcelain, log, status_short, diff, and error.
    """
    empty = {
        "status_porcelain": "",
        "log": "",
        "status_short": "",
        "diff": "",
        "error": None,
    }
    if shutil.which("podman") is None:
        return {**empty, "error": "Podman is unavailable"}
    try:
        runtime = podman_runtime(worker_id)
        command = build_worker_git_query_command(runtime, base_commit=base_commit)
    except (ValueError, OSError) as exc:
        return {**empty, "error": str(exc)}
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError) as exc:
        return {**empty, "error": str(exc)}
    if result.returncode:
        detail = (result.stderr or result.stdout or "Git query container failed").strip()
        return {**empty, "error": detail}
    parsed = _parse_worker_git_query_output(result.stdout)
    return {**parsed, "error": None}


def container_status(worker_id):
    """Return Podman reality for a worker's conventional container name."""
    try:
        validate_worker_id(worker_id)
    except ValueError:
        return "invalid-id"
    if shutil.which("podman") is None:
        return "unavailable"
    result = run("podman", "inspect", "--format", "{{.State.Status}}", f"herdr-{worker_id}")
    if result.returncode:
        detail = (result.stderr or result.stdout or "podman inspect failed").strip()
        lowered = detail.lower()
        if any(marker in lowered for marker in ("no such object", "no such container", "does not exist", "not found")):
            return "not-found"
        return f"error: {detail}"
    status = (result.stdout or "").strip().lower()
    return status or "present"


def _base_commit(repo, metadata):
    """Resolve the persisted base commit without running git in the worker repo.
    
    Security: This function must never run git with the worker repo as cwd or
    -C target. We only return metadata.base_commit if it's a valid SHA, and
    refuse to resolve base_ref through git because that would execute worker config.
    """
    candidate = metadata.get("base_commit")
    if isinstance(candidate, str) and re.fullmatch(r"[0-9a-fA-F]{40}", candidate):
        return candidate
    # Refuse to resolve base_ref by running git in the worker repo
    return None


def _git_reality(repo, metadata, worker_id=None):
    """Query worker state without running host git against the worker clone.

    HEAD and branch come from confined file reads. Status, log, and diff run
    inside a short-lived container so worker .git/config cannot execute on the
    host. When the container query is unavailable, those fields report the
    reason rather than silent placeholders.
    """
    reality = {
        "head": None,
        "branch": None,
        "dirty": None,
        "git_log": "",
        "git_status": "",
        "git_diff": "",
        "base_commit": _metadata_value(metadata, "base_commit"),
        "issues": [],
    }
    if repo.is_symlink() or not repo.is_dir():
        reality["issues"].append(f"Worker repository is missing: {repo}")
        return reality
    try:
        git_dir = _validate_worker_git_dir(repo)
    except ValueError as exc:
        reality["issues"].append(str(exc))
        return reality
    if not (git_dir / "HEAD").exists() and not (git_dir / "packed-refs").exists():
        reality["issues"].append(f"Worker repository is not a Git repository: {repo}")
        return reality

    success, head, error = _safe_read_worker_head(repo)
    if not success:
        reality["issues"].append(f"Unable to read worker HEAD: {error}")
    else:
        reality["head"] = head

    success, branch, error = _safe_read_worker_branch(repo)
    if not success:
        reality["issues"].append(f"Unable to read worker branch: {error}")
    else:
        reality["branch"] = branch or "(detached)"

    if not worker_id:
        unavailable = "(unavailable: worker id required for sandboxed git query)"
        reality["git_log"] = unavailable
        reality["git_status"] = unavailable
        reality["git_diff"] = unavailable
        return reality

    base_commit = _base_commit(repo, metadata)
    if base_commit:
        reality["base_commit"] = base_commit
    else:
        reality["issues"].append("Persisted base commit cannot be resolved in worker metadata")

    snapshot = _query_worker_git_snapshot(worker_id, base_commit=base_commit)
    if snapshot["error"]:
        reality["issues"].append(f"Unable to query worker git state: {snapshot['error']}")
        unavailable = f"(unavailable: {snapshot['error']})"
        reality["git_log"] = unavailable
        reality["git_status"] = unavailable
        reality["git_diff"] = unavailable if base_commit else "(unavailable: persisted base commit cannot be resolved)"
        return reality

    reality["dirty"] = bool(snapshot["status_porcelain"])
    reality["git_log"] = snapshot["log"]
    reality["git_status"] = snapshot["status_short"]
    if base_commit:
        reality["git_diff"] = snapshot["diff"]
    else:
        reality["git_diff"] = "(unavailable: persisted base commit cannot be resolved)"
    return reality


def _result_path(worker_dir, value):
    """Resolve a persisted result path without allowing it outside the worker."""
    if not isinstance(value, str) or not value:
        return None
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = worker_dir / candidate
    candidate = candidate.resolve()
    return candidate if candidate.is_relative_to(worker_dir.resolve()) else None


def _latest_result(worker_dir, metadata):
    """Load the latest durable run result, including for older worker metadata."""
    result_path = _result_path(worker_dir, metadata.get("latest_result"))
    if result_path is None:
        runs_dir = worker_dir / "runs"
        candidates = list(runs_dir.glob("*/result.json")) if runs_dir.is_dir() else []
        result_path = max(candidates, key=lambda path: path.stat().st_mtime_ns, default=None)
    if result_path is None:
        return None, None
    try:
        with result_path.open() as stream:
            result = json.load(stream)
        if not isinstance(result, dict):
            raise ValueError("result must be a JSON object")
    except (OSError, json.JSONDecodeError, ValueError) as exc:
        return None, f"Invalid execution result {result_path}: {exc}"
    result.setdefault("result_location", str(result_path))
    if not isinstance(result.get("log_location"), str) or not result["log_location"]:
        result["log_location"] = str(result_path.with_name("output.log"))
    result.setdefault("output_location", result["log_location"])
    return result, None


def _latest_result_summary(result):
    if not result:
        return "-"
    run_id = result.get("run_id", "-")
    exit_status = _display(result.get("exit_status"))
    head = str(result.get("head") or "-")[:12]
    dirty = _display(result.get("dirty"))
    return f"{run_id} exit={exit_status} HEAD={head} dirty={dirty}"


def _result_branch_for(metadata, worker_id):
    """Return the source-repo result branch name, or None when not fetched."""
    value = metadata.get("result_branch")
    if isinstance(value, str) and value.strip():
        return value.strip()
    if metadata.get("status") == "fetched":
        return f"sandbox/{worker_id}"
    return None


def _apply_container_status(record, worker_id):
    """Set container and derived lifecycle status from live Podman state."""
    record["container"] = container_status(worker_id)
    if record["container"] == "unavailable":
        record["issues"].append("Podman is unavailable; container state could not be checked")
    elif record["container"].startswith("error:"):
        record["issues"].append(f"Unable to inspect worker container: {record['container'][len('error: '):]}")
    if record["container"] == "running":
        record["status"] = "running"
    elif record["metadata_status"] == "running" and record["container"] == "not-found":
        record["status"] = "stale"
        record["issues"].append("Metadata says running but no corresponding container exists")
    elif record["metadata_status"] == "running" and (
        record["container"] == "unavailable" or record["container"].startswith("error:")
    ):
        record["status"] = "unknown"
        record["issues"].append("Persisted lifecycle says running, but live container state is unavailable")
    elif record["container"] in {"exited", "stopped", "created", "paused", "unknown"} and record["metadata_status"] == "running":
        record["status"] = "stopped"
    elif record["metadata_status"] in LIFECYCLE_STATES:
        record["status"] = record["metadata_status"]
    else:
        record["status"] = "invalid" if record["issues"] else "unknown"


def _worker_record(worker_dir, *, detail=False):
    """Build a recoverable view from worker.json and live container state.

    List views (`detail=False`) stay fast: they read the state store and call
    ``container_status`` only. They never start a git-query container.
    Inspect views (`detail=True`) add sandboxed git reality and the latest run.
    """
    worker_id = worker_dir.name
    record = {
        "id": worker_id,
        "worker_dir": str(worker_dir),
        "repository": str(worker_dir / "repo"),
        "source_repo": "-",
        "agent": "-",
        "pane_id": "-",
        "result_branch": None,
        "base_ref": "-",
        "base_commit": None,
        "branch": "-",
        "metadata_branch": "-",
        "created_at": "-",
        "runtime": "-",
        "network": "-",
        "metadata_status": "unknown",
        "status": "invalid",
        "container": "not-checked",
        "head": None,
        "dirty": None,
        "git_log": "",
        "git_status": "",
        "git_diff": "",
        "latest_result": None,
        "actual_branch": None,
        "issues": [],
    }
    if worker_dir.is_symlink() or not worker_dir.is_dir():
        record["issues"].append("Worker state entry is not a real directory")
        return record

    metadata_path = worker_dir / "worker.json"
    metadata = {}
    if not metadata_path.is_file():
        record["issues"].append(f"Missing worker metadata: {metadata_path}")
    else:
        try:
            with metadata_path.open() as stream:
                metadata = json.load(stream)
            if not isinstance(metadata, dict):
                raise ValueError("metadata must be a JSON object")
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            record["issues"].append(f"Invalid worker metadata {metadata_path}: {exc}")
            metadata = {}

    record["source_repo"] = _metadata_value(metadata, "source_repo")
    record["agent"] = _metadata_value(metadata, "agent")
    record["pane_id"] = _metadata_value(metadata, "pane_id")
    record["result_branch"] = _result_branch_for(metadata, worker_id)
    record["base_ref"] = _metadata_value(metadata, "base_ref")
    base_commit = metadata.get("base_commit")
    record["base_commit"] = base_commit if isinstance(base_commit, str) and base_commit else None
    record["branch"] = _metadata_value(metadata, "branch")
    record["metadata_branch"] = record["branch"]
    record["created_at"] = _metadata_value(metadata, "created_at")
    record["runtime"] = _metadata_value(metadata, "runtime")
    record["network"] = _metadata_value(metadata, "network")
    record["metadata_status"] = _metadata_value(metadata, "status", "unknown")
    if (
        record["metadata_status"] not in LIFECYCLE_STATES
        and record["metadata_status"] != "unknown"
    ):
        record["issues"].append(f"Unknown persisted lifecycle status: {record['metadata_status']}")
    if metadata and metadata.get("id") != worker_id:
        record["issues"].append(f"Metadata ID does not match state directory ({metadata.get('id', '-')})")

    source = Path(record["source_repo"]).expanduser() if record["source_repo"] != "-" else None
    if source is not None and not source.is_dir():
        record["issues"].append(f"Source repository is missing: {source}")

    repo = worker_dir / "repo"
    if detail:
        reality = _git_reality(repo, metadata, worker_id=worker_id)
        record.update({key: reality[key] for key in ("head", "dirty", "git_log", "git_status", "git_diff")})
        if reality.get("base_commit"):
            record["base_commit"] = reality["base_commit"]
        record["issues"].extend(reality["issues"])
        record["latest_result"], result_issue = _latest_result(worker_dir, metadata)
        if result_issue:
            record["issues"].append(result_issue)
        if reality["branch"]:
            actual_branch = reality["branch"]
            if record["metadata_branch"] != "-" and record["metadata_branch"] != actual_branch:
                record["issues"].append(
                    f"Branch differs from metadata ({record['metadata_branch']} vs {actual_branch})"
                )
            record["branch"] = actual_branch
            record["actual_branch"] = actual_branch
    elif repo.is_symlink() or not repo.is_dir():
        # List path: detect a missing clone without starting a git-query container.
        record["issues"].append(f"Worker repository is missing: {repo}")

    _apply_container_status(record, worker_id)
    if any(issue.startswith("Worker repository") for issue in record["issues"]):
        record["status"] = "missing-repo"
    if metadata and not record["issues"] and record["status"] == "invalid":
        record["status"] = "unknown"
    return record


def list_workers(state_dir=None):
    """List persisted workers from the state store without sandboxed git queries."""
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.exists():
        return []
    if workers_dir.is_symlink() or not workers_dir.is_dir():
        raise ValueError(f"Worker state directory is not a real directory: {workers_dir}")
    return [
        _worker_record(entry, detail=False)
        for entry in sorted(workers_dir.iterdir(), key=lambda path: path.name)
        if entry.name not in {".", ".."}
    ]


def inspect_worker(worker_id, state_dir=None):
    """Inspect one worker, including sandboxed git reality and review commands."""
    worker_dir = worker_dir_for(worker_id, state_dir)
    if not worker_dir.exists() or worker_dir.is_symlink():
        raise ValueError(f"Worker not found: {worker_id}")
    return _worker_record(worker_dir, detail=True)


def cwd_repo_root(state_dir=None):
    """Resolve the source Git root for cwd by walking for ``.git`` (no host git).

    Never runs ``git`` against the process cwd: that path may be a worker clone
    whose ``.git/config`` is attacker-controlled. If the discovered root lies
    under ``state_workers_dir()``, treat it as not a source repo and return None
    so inspect requires an explicit worker ID.
    """
    try:
        current = Path.cwd().resolve()
    except OSError:
        return None
    root = None
    for candidate in (current, *current.parents):
        git_entry = candidate / ".git"
        try:
            if git_entry.exists():
                root = candidate
                break
        except OSError:
            continue
    if root is None:
        return None
    try:
        workers_dir = state_workers_dir(state_dir).resolve()
    except (OSError, ValueError, TypeError):
        return root
    try:
        if root == workers_dir or root.is_relative_to(workers_dir):
            return None
    except (OSError, ValueError):
        return None
    return root


def _list_worker_ids(state_dir=None):
    """Return sorted valid worker IDs from the state store."""
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.is_dir() or workers_dir.is_symlink():
        return []
    return sorted(
        entry.name
        for entry in workers_dir.iterdir()
        if entry.is_dir() and not entry.is_symlink() and WORKER_ID_RE.fullmatch(entry.name)
    )


def _workers_for_pane_and_repo(pane_id, source_repo, state_dir=None):
    """Find workers matching (pane_id, source_repo) for any agent."""
    source_repo = Path(source_repo).expanduser().resolve()
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.is_dir() or workers_dir.is_symlink():
        return []
    matches = []
    for entry in sorted(workers_dir.iterdir(), key=lambda path: path.name):
        if not entry.is_dir() or entry.is_symlink() or not WORKER_ID_RE.fullmatch(entry.name):
            continue
        metadata_path = entry / "worker.json"
        if not metadata_path.is_file():
            continue
        try:
            with metadata_path.open() as stream:
                metadata = json.load(stream)
            if not isinstance(metadata, dict):
                continue
            if metadata.get("pane_id") != pane_id:
                continue
            recorded = metadata.get("source_repo")
            if not isinstance(recorded, str) or not recorded:
                continue
            if Path(recorded).expanduser().resolve() != source_repo:
                continue
            matches.append(entry.name)
        except (OSError, json.JSONDecodeError, ValueError):
            continue
    return matches


def resolve_inspect_worker(worker_id=None, state_dir=None):
    """Resolve the inspect target from an explicit ID or the current pane.

    With no ID, match workers for (HERDR_PANE_ID, cwd repo, any agent). Never
    fall back to ``[inspect].id`` or ``sole_worker_id()``.
    """
    if worker_id:
        return worker_id
    pane_id, _, _ = _get_pane_context()
    candidates = _list_worker_ids(state_dir)
    candidate_text = ", ".join(candidates) if candidates else "(none)"
    if not pane_id:
        raise ValueError(
            "HERDR_PANE_ID is unset; pass an explicit worker ID "
            f"(candidates: {candidate_text})."
        )
    source = cwd_repo_root(state_dir=state_dir)
    if source is None:
        raise ValueError(
            "Current directory is not inside a source Git repository "
            "(worker clones under plugin state are not valid); pass an explicit worker ID "
            f"(candidates: {candidate_text})."
        )
    matches = _workers_for_pane_and_repo(pane_id, source, state_dir)
    if len(matches) == 1:
        return matches[0]
    if not matches:
        raise ValueError(
            f"No worker found for pane {pane_id} in {source}; pass an explicit worker ID "
            f"(candidates: {candidate_text})."
        )
    raise ValueError(
        f"Multiple workers match pane {pane_id} in {source}: {', '.join(matches)}. "
        "Pass an explicit worker ID."
    )


def _display(value, missing="-"):
    if value is None:
        return missing
    if isinstance(value, bool):
        return "yes" if value else "no"
    return str(value)


def _review_base_ref(record):
    """Pick a base label for source-repo review commands."""
    base_ref = record.get("base_ref")
    if isinstance(base_ref, str) and base_ref and base_ref != "-":
        return base_ref
    base_commit = record.get("base_commit")
    if isinstance(base_commit, str) and base_commit:
        return base_commit[:12] if len(base_commit) >= 12 else base_commit
    return "BASE"


def format_workers(records):
    """Render `hs ls` columns: id, agent, source, pane, status, result, created."""
    columns = ("ID", "AGENT", "SOURCE", "PANE", "STATUS", "RESULT", "CREATED")
    rows = [columns]
    for record in records:
        rows.append((
            record["id"],
            _display(record.get("agent")),
            _display(record.get("source_repo")),
            _display(record.get("pane_id")),
            record["status"],
            _display(record.get("result_branch")),
            _display(record.get("created_at")),
        ))
    if len(rows) == 1:
        return "No sandbox workers found."
    widths = [max(len(str(row[index])) for row in rows) for index in range(len(columns))]
    return "\n".join(
        "  ".join(str(value).ljust(widths[index]) for index, value in enumerate(row)).rstrip()
        for row in rows
    )


def format_worker(record):
    result_branch = _display(record.get("result_branch"))
    base = _review_base_ref(record)
    source = record["source_repo"]
    _, review_cmds, _, _ = _review_git_commands(source, base, record["id"])
    lines = [
        f"Worker: {record['id']}",
        f"Agent: {_display(record.get('agent'))}",
        f"Source: {source}",
        f"Pane: {_display(record.get('pane_id'))}",
        f"Result branch: {result_branch}",
        f"Worker clone: {record['repository']}",
        f"Base: {record['base_ref']}",
        f"Branch: {record['branch']}",
        f"Runtime: {record['runtime']}",
        f"Network: {record['network']}",
        f"Container: {record['container']}",
        f"Status: {record['status']}",
        f"Created: {record['created_at']}",
        f"HEAD: {record['head'] or '-'}",
        f"Dirty: {_display(record['dirty'])}",
    ]
    latest = record.get("latest_result")
    if latest:
        lines.extend([
            "Latest result:",
            f"  Run: {latest.get('run_id', '-')}",
            f"  Status: {latest.get('status', '-')}",
            f"  Exit status: {_display(latest.get('exit_status'))}",
            f"  HEAD: {latest.get('head') or '-'}",
            f"  Dirty: {_display(latest.get('dirty'))}",
            f"  Result: {latest.get('result_location', '-')}",
            f"  Log: {latest.get('log_location', '-')}",
        ])
    if record["issues"]:
        lines.extend(["Issues:"] + [f"- {issue}" for issue in record["issues"]])
    lines.extend([
        "",
        f"Review (run in source repo {source}):",
        *review_cmds,
        "",
        "Git log:",
        record["git_log"] or "(no commits)",
        "",
        "Git status:",
        record["git_status"] or "(clean)",
        "",
        f"Git diff {record['base_ref']}...HEAD:",
        record["git_diff"] or "(no changes)",
    ])
    return "\n".join(lines)


def _sanitize_for_worker_id(text):
    """Sanitize text to match WORKER_ID_RE: alphanumeric, dots, underscores, hyphens."""
    text = re.sub(r"[^A-Za-z0-9._-]+", "-", text)
    text = re.sub(r"^[^A-Za-z0-9]+", "", text)
    text = re.sub(r"-+", "-", text)
    text = text.strip("-._")
    return text if text else "worker"


def _repo_slug_from_path(repo_path):
    """Derive a short slug from the repository directory name."""
    repo = Path(repo_path).expanduser().resolve()
    slug = _sanitize_for_worker_id(repo.name)
    max_slug_length = MAX_WORKER_ID_LENGTH - 9
    if len(slug) > max_slug_length:
        slug = slug[:max_slug_length]
    return slug


def generate_worker_id(repo_path, state_dir=None):
    """Generate a worker ID as <repo-slug>-<short-random>."""
    slug = _repo_slug_from_path(repo_path)
    workers_dir = state_workers_dir(state_dir)
    for attempt in range(100):
        random_suffix = secrets.token_hex(3)
        worker_id = f"{slug}-{random_suffix}"
        if len(worker_id) > MAX_WORKER_ID_LENGTH:
            worker_id = worker_id[:MAX_WORKER_ID_LENGTH]
        try:
            validate_worker_id(worker_id)
            git("check-ref-format", "--branch", f"agent/{worker_id}")
            git("check-ref-format", "--branch", f"sandbox/{worker_id}")
        except ValueError:
            continue
        candidate_dir = workers_dir / worker_id
        if not candidate_dir.exists():
            return worker_id
    raise ValueError(f"Unable to generate a unique worker ID after 100 attempts for {repo_path}")


def _state_lock_path(state_dir=None):
    """Return the path to the global state lock file."""
    if state_dir is None:
        _, state_dir = paths()
    return Path(state_dir) / "state.lock"


class StateLock:
    """Exclusive file lock for state store operations.

    When ``blocking`` is False, acquire with ``LOCK_NB`` and raise
    ``BlockingIOError`` immediately if another holder owns the lock so
    opportunistic GC never stalls a launch.
    """

    def __init__(self, state_dir=None, blocking=True):
        self.lock_path = _state_lock_path(state_dir)
        self.lock_file = None
        self.blocking = blocking

    def __enter__(self):
        self.lock_path.parent.mkdir(parents=True, exist_ok=True)
        self.lock_file = self.lock_path.open("a")
        flags = fcntl.LOCK_EX if self.blocking else fcntl.LOCK_EX | fcntl.LOCK_NB
        try:
            fcntl.flock(self.lock_file.fileno(), flags)
        except BlockingIOError:
            self.lock_file.close()
            self.lock_file = None
            raise
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.lock_file:
            fcntl.flock(self.lock_file.fileno(), fcntl.LOCK_UN)
            self.lock_file.close()
            self.lock_file = None
        return False


def _atomic_write_json(path, data):
    """Write JSON atomically with fsync."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    content = json.dumps(data, indent=2) + "\n"
    fd, temp_path = tempfile.mkstemp(dir=path.parent, prefix=".tmp-", suffix=".json")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp_path, path)
    except Exception:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def _get_pane_context():
    """Extract pane, workspace IDs, and socket path from environment."""
    pane_id = os.environ.get("HERDR_PANE_ID", "").strip()
    workspace_id = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
    socket_path = os.environ.get("HERDR_SOCKET_PATH", "").strip()
    return (
        pane_id if pane_id else None,
        workspace_id if workspace_id else None,
        socket_path if socket_path else None,
    )


def find_reusable_worker(source_repo, agent, state_dir=None):
    """Find an existing worker that matches the reuse key (pane, socket, repo, agent).
    
    Returns a tuple: (worker_id or None, head_moved_notice or None)
    
    The reuse key includes socket_path to prevent collision when multiple Herdr
    servers run simultaneously (verified with Herdr 0.9.5: two servers can both
    have w1:p1 but with different HERDR_SOCKET_PATH values).
    
    If a matching worker is found but source HEAD has moved, the worker is still
    reused (to preserve any uncommitted work), but a notice is returned.
    """
    pane_id, _, socket_path = _get_pane_context()
    if not pane_id:
        return None, None
    
    source_repo = Path(source_repo).expanduser().resolve()
    workers_dir = state_workers_dir(state_dir)
    if not workers_dir.is_dir():
        return None, None
    
    for entry in workers_dir.iterdir():
        if not entry.is_dir() or entry.is_symlink():
            continue
        if not WORKER_ID_RE.fullmatch(entry.name):
            continue
        
        metadata_path = entry / "worker.json"
        if not metadata_path.is_file():
            continue
        
        try:
            with metadata_path.open() as f:
                metadata = json.load(f)
            
            if not isinstance(metadata, dict):
                continue
            
            recorded_pane = metadata.get("pane_id")
            recorded_socket = metadata.get("socket_path")
            recorded_repo = metadata.get("source_repo")
            recorded_agent = metadata.get("agent")
            
            if recorded_pane != pane_id:
                continue
            if recorded_socket != socket_path:
                continue
            if recorded_agent != agent:
                continue
            if not recorded_repo:
                continue
            
            recorded_repo_path = Path(recorded_repo).expanduser().resolve()
            if recorded_repo_path != source_repo:
                continue
            
            # Check if source HEAD has moved since worker's base commit
            head_moved_notice = None
            base_commit = metadata.get("base_commit")
            if base_commit and isinstance(base_commit, str):
                try:
                    current_head = git("-C", source_repo, "rev-parse", "HEAD")
                    if current_head != base_commit:
                        head_moved_notice = (
                            f"Notice: reusing worker {entry.name}; source HEAD has moved from "
                            f"{base_commit[:12]} to {current_head[:12]}. The worker is based on the original commit."
                        )
                except (ValueError, subprocess.CalledProcessError):
                    pass
            
            return entry.name, head_moved_notice
        except (OSError, json.JSONDecodeError, ValueError):
            continue
    
    return None, None


def create_options(config_dir):
    config_file = config_dir / "config.toml"
    with config_file.open("rb") as stream:
        config = tomllib.load(stream)
    options = config.get("create", {})
    if not isinstance(options, dict):
        raise ValueError(f"Expected a [create] table in {config_file}.")
    for key in ("id", "source_repo", "base_ref"):
        if key in options and not isinstance(options[key], str):
            raise ValueError(f"Set [create].{key} to a string in {config_file}.")
    return options


def resolve_prompt_argument(prompt):
    """Resolve ``--prompt`` text, including ``--prompt -`` reading stdin."""
    if prompt is None:
        raise ValueError('Task prompt is required. Pass --prompt "..." (or --prompt - to read stdin).')
    if prompt == "-":
        prompt = sys.stdin.read()
    if not isinstance(prompt, str) or not prompt.strip():
        raise ValueError("Task prompt must be a nonempty string.")
    return prompt


def create_worker(worker_id, repo=None, base_ref="HEAD", agent=None):
    """Create a new worker with generated ID and pane tracking.
    
    Args:
        worker_id: Worker ID, or None to generate one
        repo: Source repository path
        base_ref: Base ref or commit (default: HEAD)
        agent: Agent name (default: DEFAULT_PROFILE.name)
    """
    if agent is None:
        agent = DEFAULT_PROFILE.name
    if not base_ref or base_ref.startswith("-") or any(char.isspace() for char in base_ref):
        raise ValueError("Base ref must be a nonempty Git ref or commit without whitespace or a leading hyphen.")
    repo = repo or context_repo()
    if not repo:
        raise ValueError("Source repository is missing. Pass --repo or invoke from a Herdr Git workspace.")
    source = Path(repo).expanduser().resolve()
    if not source.is_dir():
        raise ValueError(f"Source repository does not exist: {source}.")
    source_root = Path(git("-C", source, "rev-parse", "--show-toplevel")).resolve()
    if source_root != source:
        source = source_root
    
    errors = check(str(source))
    if errors:
        raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
    
    _, state_dir = paths()
    if not state_dir.is_dir():
        raise ValueError(f"Plugin state directory is missing: {state_dir}. Run the setup action.")
    state_dir = state_dir.resolve()
    if state_dir.is_relative_to(source):
        raise ValueError("Plugin state directory must be outside the source repository.")
    
    with StateLock(state_dir):
        if worker_id is None:
            worker_id = generate_worker_id(source, state_dir)
        else:
            validate_worker_id(worker_id)
        
        branch = f"agent/{worker_id}"
        git("check-ref-format", "--branch", branch)
        sandbox_branch = f"sandbox/{worker_id}"
        git("check-ref-format", "--branch", sandbox_branch)
        
        user_name, user_email = source_git_identity(str(source))
        commit = git("-C", source, "rev-parse", "--verify", "--end-of-options", f"{base_ref}^{{commit}}")
        
        workers_dir = state_dir / "workers"
        workers_dir.mkdir(exist_ok=True)
        if workers_dir.resolve() != workers_dir or not workers_dir.is_dir():
            raise ValueError("Plugin workers directory must be a real directory inside plugin state.")
        
        destination = workers_dir / worker_id
        try:
            destination.mkdir()
        except FileExistsError as exc:
            raise ValueError(f"Worker already exists: {worker_id}.") from exc
        
        try:
            clone = destination / "repo"
            git("clone", "--no-hardlinks", "--no-checkout", source, clone)
            
            # Ensure no alternates file exists (worker must never access source objects)
            alternates_file = clone / ".git" / "objects" / "info" / "alternates"
            if alternates_file.exists():
                alternates_file.unlink()
            
            git("-C", clone, "config", "--local", "user.name", user_name)
            git("-C", clone, "config", "--local", "user.email", user_email)
            git("-C", clone, "switch", "--detach", commit)
            git("-C", clone, "switch", "-c", branch)
            
            pane_id, workspace_id, socket_path = _get_pane_context()
            
            metadata = {
                "id": worker_id,
                "source_repo": str(source),
                "agent": agent,
                "pane_id": pane_id,
                "workspace_id": workspace_id,
                "socket_path": socket_path,
                "base_ref": base_ref,
                "base_commit": commit,
                "branch": branch,
                "created_at": datetime.now(timezone.utc).isoformat(),
                "runtime": "podman",
                "network": "online",
                "status": "created",
                "result_branch": None,
                "fetched_commit": None,
            }
            _atomic_write_json(destination / "worker.json", metadata)
        except (ValueError, OSError):
            shutil.rmtree(destination, ignore_errors=True)
            raise
    
    return destination


def check_dirty_tree(repo):
    """Check if repository has uncommitted or untracked changes."""
    result = run("git", "-C", str(repo), "status", "--porcelain")
    if result.returncode != 0:
        raise ValueError(f"Unable to check repository status: {result.stderr.strip() or 'git failed'}")
    return bool(result.stdout.strip())


def check_root():
    """Refuse to run as root."""
    if os.geteuid() == 0:
        raise ValueError("Refusing to run as root. Run this command as a regular user with rootless Podman.")


def ensure_image_exists(config_dir):
    """Build image lazily if it doesn't exist."""
    if shutil.which("podman") is None:
        return
    
    image, _ = load_config(config_dir)
    result = run("podman", "image", "exists", image)
    
    if result.returncode != 0:
        print(f"Worker image {image} not found. Building it now...", file=sys.stderr)
        build_image()
        print(f"Image {image} built successfully.", file=sys.stderr)


def resolve_source_repo_from_cwd():
    """Resolve source repository from current working directory."""
    cwd = Path.cwd()
    result = run("git", "-C", str(cwd), "rev-parse", "--show-toplevel")
    if result.returncode != 0:
        raise ValueError(f"Current directory is not in a Git repository: {cwd}")
    return Path(result.stdout.strip()).resolve()


def prepare_hs_worker(agent=None):
    """Shared launcher setup: root check, GC, dirty refuse, create or reuse worker.

    Returns ``(worker_id, state_dir)``. Prints one-line errors to stderr and
    returns ``(None, None)`` when launch must abort with exit status 1.
    """
    if agent is None:
        agent = DEFAULT_PROFILE.name
    profile = get_profile(agent)
    check_root()

    config_dir, state_dir = paths()

    # Opportunistic GC must never fail the launch.
    opportunistic_gc(state_dir=state_dir, config_dir=config_dir)
    try:
        _, agent_home = load_config(config_dir, profile)
        sweep_stale_agent_sessions(agent_home, state_dir=state_dir, profile=profile)
    except Exception as exc:  # noqa: BLE001 - launch must not fail because of session sweep
        print(f"{profile.name} session sweep skipped: {exc}", file=sys.stderr)

    try:
        source_repo = resolve_source_repo_from_cwd()
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return None, None

    if check_dirty_tree(source_repo):
        print(
            f"Refusing: source repository has uncommitted or untracked changes: {source_repo}",
            file=sys.stderr,
        )
        return None, None

    try:
        ensure_image_exists(config_dir)
    except Exception as exc:
        print(f"Image build failed: {exc}", file=sys.stderr)
        return None, None

    worker_id, head_moved_notice = find_reusable_worker(source_repo, agent, state_dir)

    if worker_id is None:
        try:
            worker_dir = create_worker(None, str(source_repo), "HEAD", agent)
            worker_id = worker_dir.name
            print(f"Created worker: {worker_id}", file=sys.stderr)
        except Exception as exc:
            print(f"Worker creation failed: {exc}", file=sys.stderr)
            return None, None
    else:
        print(f"Reusing worker: {worker_id}", file=sys.stderr)
        if head_moved_notice:
            print(head_moved_notice, file=sys.stderr)

    return worker_id, state_dir


def hs_agent(profile, agent_args, prompt=None):
    """Create or reuse a worker and launch the given agent profile.

    Without ``prompt``, opens an interactive session (per-launch temp home)
    then auto-fetches into ``sandbox/<id>``. With ``prompt``, runs the profile's
    noninteractive argv with the same per-launch home and auth write-back,
    writes ``runs/<run-id>/result.json`` / ``output.log``, auto-fetches, and
    returns the agent's exit status.
    """
    worker_id, state_dir = prepare_hs_worker(profile.name)
    if worker_id is None:
        return 1

    if prompt is not None:
        extra = [arg for arg in (agent_args or []) if arg != "--"]
        if extra:
            print(
                f"Do not pass extra {profile.name} arguments with --prompt; "
                f"use interactive `hs {profile.name}` without --prompt.",
                file=sys.stderr,
            )
            return 1
        try:
            prompt = resolve_prompt_argument(prompt)
            result = execute_worker(worker_id, prompt, profile=profile)
        except (ValueError, OSError) as exc:
            print(exc, file=sys.stderr)
            return 1
        print_execution_result(result)
        exit_status = result["exit_status"]
        if result.get("result_branch") is None:
            return exit_status if exit_status else 1
        return exit_status

    try:
        command = [profile.interactive_bin] + list(agent_args or [])
        exit_code = open_worker(worker_id, command, fresh=True, profile=profile)
    except Exception as exc:
        print(f"Worker launch failed: {exc}", file=sys.stderr)
        return 1

    try:
        print(format_fetch_result(fetch_worker(worker_id, state_dir)))
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        print(
            f"Worker {worker_id} was left un-fetched. "
            f"Switch away from sandbox/{worker_id} if it is checked out, then run: hs fetch {worker_id}",
            file=sys.stderr,
        )
        return exit_code if exit_code else 1
    return exit_code


def login_agent(agent_name):
    """Run the profile login with the home env pointed at the plugin-owned home.

    Refuses every registered agent's normal user home.
    """
    profile = get_profile(agent_name)
    config_dir, _ = paths()
    try:
        load_config(config_dir, profile)
    except ValueError:
        setup()
    agent_home = resolve_agent_home(config_dir, profile)
    banned = {other.normal_user_home_path() for other in AGENT_PROFILES.values()}
    if agent_home in banned or agent_home == Path.home().resolve():
        raise ValueError(
            f"Refusing to run login against the normal user {profile.name} home "
            f"({profile.normal_user_home_path()}). Use the plugin-owned home."
        )
    agent_home.mkdir(parents=True, exist_ok=True)
    agent_home.chmod(0o700)
    if not profile.login_argv or profile.login_argv[0].startswith("-"):
        raise ValueError(f"Invalid login command for {profile.name}.")
    env = os.environ.copy()
    env[profile.home_env_var] = str(agent_home)
    print(f"Logging in {profile.name} with {profile.home_env_var}={agent_home}")
    result = subprocess.run(list(profile.login_argv), env=env, check=False)
    return result.returncode


def resolve_fetch_worker(worker_id, config_dir):
    """Resolve a fetch target from a positional/option ID, config, or sole worker."""
    if worker_id:
        return worker_id
    return configured_or_sole_worker(None, config_dir, fetch_options, "fetch")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("setup")
    commands.add_parser("bootstrap", help="Set up the plugin and build the worker image")
    commands.add_parser("build-image")
    check_parser = commands.add_parser("check")
    check_parser.add_argument("--repo", help="Also verify a source Git repository")
    check_parser.add_argument(
        "--execution",
        action="store_true",
        help="Also require dedicated agent authentication",
    )
    create_parser = commands.add_parser("create")
    create_parser.add_argument("--id", help="Worker ID (prompted for in an interactive terminal)")
    create_parser.add_argument("--repo", help="Source repository (defaults to the Herdr workspace)")
    create_parser.add_argument("--base", help="Base ref or commit (default: HEAD)")
    fetch_parser = commands.add_parser("fetch", help="Fetch worker HEAD into refs/heads/sandbox/<id>")
    fetch_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    fetch_parser.add_argument("--id", dest="option_worker_id", help="Worker ID (or configure [fetch].id)")
    destroy_parser = commands.add_parser(
        "destroy",
        help="Alias of rm: remove one sandbox worker (deprecated name; use rm)",
    )
    destroy_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    destroy_parser.add_argument("--id", dest="option_worker_id", help="Worker ID")
    destroy_parser.add_argument(
        "--force",
        action="store_true",
        help="Remove even if the worker container is running",
    )
    rm_parser = commands.add_parser("rm", help="Remove one sandbox worker")
    rm_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    rm_parser.add_argument("--id", dest="option_worker_id", help="Worker ID")
    rm_parser.add_argument(
        "--force",
        action="store_true",
        help="Remove even if the worker container is running",
    )
    gc_parser = commands.add_parser(
        "gc",
        help="Remove fetched workers whose panes are gone, or workers older than [gc].max_age",
    )
    gc_parser.add_argument(
        "--pane",
        help="Collect only fetched workers recorded for this Herdr pane ID",
    )
    gc_parser.add_argument(
        "--from-event",
        action="store_true",
        help="Read pane_id from HERDR_PLUGIN_EVENT_JSON (pane.closed hook)",
    )
    list_parser = commands.add_parser("list", aliases=["ls"], help="List persisted sandbox workers")
    list_parser.add_argument("--json", action="store_true", help="Print structured JSON")
    inspect_parser = commands.add_parser(
        "inspect",
        help="Inspect one sandbox worker (defaults to this pane's worker)",
    )
    inspect_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    inspect_parser.add_argument("--id", dest="option_worker_id", help="Worker ID")
    inspect_parser.add_argument("--json", action="store_true", help="Print structured JSON")
    open_parser = commands.add_parser("open", help="Open an interactive sandbox worker")
    open_parser.add_argument("worker_id", nargs="?", help="Worker ID")
    open_parser.add_argument("--id", dest="option_worker_id", help="Worker ID (for Herdr action configuration)")
    open_parser.add_argument(
        f"--{DEFAULT_PROFILE.name}",
        dest="start_default_agent",
        action="store_true",
        help=f"Start {DEFAULT_PROFILE.name} instead of the default shell",
    )
    open_parser.add_argument("session_command", nargs=argparse.REMAINDER, help="Command and arguments to run in the worker")
    start_name = f"start-{DEFAULT_PROFILE.name}"
    start_parser = commands.add_parser(
        start_name,
        help=f"Start a fresh {DEFAULT_PROFILE.name} session in a sandbox worker",
    )
    start_parser.add_argument("--id", help="Worker ID (or configure [open].id)")
    pane_open_parser = commands.add_parser(
        "pane-open",
        help=f"Open the {start_name} pane through Herdr with validated placement",
    )
    pane_open_parser.add_argument("--placement", help="Pane placement: overlay, split, or tab (default: overlay)")
    pane_open_parser.add_argument("--target-pane", help="Target pane for split placement (for example, w1:p1)")
    pane_open_parser.add_argument("--direction", help="Split direction: right or down")
    execute_parser = commands.add_parser(
        "execute",
        help=(
            f"Alias of {DEFAULT_PROFILE.name} --prompt: run one noninteractive "
            f"{DEFAULT_PROFILE.name} task (deprecated name; use hs {DEFAULT_PROFILE.name} --prompt)"
        ),
    )
    execute_parser.add_argument(
        "--prompt",
        dest="option_prompt",
        help='Task prompt (use "-" to read stdin)',
    )
    workers_parser = commands.add_parser("workers", help=argparse.SUPPRESS)
    workers_parser.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    login_parser = commands.add_parser("login", help="Authenticate an agent into its plugin-owned home")
    login_parser.add_argument(
        "agent",
        help=f"Agent name ({', '.join(sorted(AGENT_PROFILES))})",
    )
    for profile in AGENT_PROFILES.values():
        agent_parser = commands.add_parser(
            profile.name,
            help=f"Create or reuse worker and launch {profile.name}",
        )
        agent_parser.add_argument(
            "--prompt",
            help='Run noninteractively with this task prompt (use "-" to read stdin)',
        )
        agent_parser.add_argument(
            "agent_args",
            nargs=argparse.REMAINDER,
            help=f"Arguments to pass to {profile.name}",
        )
    args = parser.parse_args()
    try:
        try:
            config_dir, _ = paths()
            warn_deprecated_integration_config(config_dir)
        except ValueError:
            pass
        if args.command == "setup":
            setup()
        elif args.command == "bootstrap":
            bootstrap()
        elif args.command == "build-image":
            build_image()
        elif args.command == "create":
            config_dir, _ = paths()
            options = create_options(config_dir)
            worker_id = args.id or options.get("id")
            if not worker_id and sys.stdin.isatty():
                worker_id = input("Worker ID: ").strip()
            worker_dir = create_worker(
                worker_id or None,
                args.repo or options.get("source_repo"),
                args.base or options.get("base_ref") or "HEAD"
            )
            print(worker_dir)
        elif args.command in {"destroy", "rm"}:
            worker_id = args.worker_id or args.option_worker_id
            if not worker_id:
                raise ValueError(
                    "Worker ID is required. Pass `rm WORKER_ID` or `rm --id WORKER_ID` "
                    "(destroy --id remains an alias)."
                )
            removed = destroy_worker(worker_id, force=args.force, warn_unfetched=True)
            verb = "Removed" if args.command == "rm" else "Destroyed"
            print(f"{verb} worker: {worker_id}" if removed else f"Worker already absent: {worker_id}")
        elif args.command == "gc":
            config_dir, state_dir = paths()
            pane = args.pane
            if args.from_event:
                if pane:
                    raise ValueError("Pass either --pane or --from-event, not both.")
                pane = parse_plugin_event_json(os.environ.get("HERDR_PLUGIN_EVENT_JSON"))
            allow_fetch = pane is None and not args.from_event
            with StateLock(state_dir):
                result = gc_collect_workers(
                    state_dir=state_dir,
                    config_dir=config_dir,
                    pane_id=pane,
                    allow_fetch=allow_fetch,
                )
            for warning in result["warnings"]:
                print(warning, file=sys.stderr)
            if result["removed"]:
                print(f"Collected workers: {', '.join(result['removed'])}")
            else:
                print("No workers collected.")
            try:
                for profile in AGENT_PROFILES.values():
                    _, agent_home = load_config(config_dir, profile)
                    swept = sweep_stale_agent_sessions(
                        agent_home, state_dir=state_dir, profile=profile,
                    )
                    if swept:
                        print(
                            f"Swept {profile.name} session homes: {', '.join(swept)}",
                            file=sys.stderr,
                        )
            except ValueError as exc:
                print(f"Agent session sweep skipped: {exc}", file=sys.stderr)
        elif args.command == "fetch":
            config_dir, _ = paths()
            worker_id = resolve_fetch_worker(
                args.worker_id or args.option_worker_id,
                config_dir,
            )
            print(format_fetch_result(fetch_worker(worker_id)))
        elif args.command in {"list", "ls", "workers"}:
            records = list_workers()
            if args.json:
                print(json.dumps(records, indent=2))
            else:
                print(format_workers(records))
        elif args.command == "inspect":
            _, state_dir = paths()
            worker_id = resolve_inspect_worker(
                args.worker_id or args.option_worker_id,
                state_dir=state_dir,
            )
            record = inspect_worker(worker_id)
            if args.json:
                print(json.dumps(record, indent=2))
            else:
                print(format_worker(record))
        elif args.command == "open":
            config_dir, _ = paths()
            worker_id = resolve_open_worker(args.worker_id or args.option_worker_id, config_dir)
            if args.start_default_agent:
                command = [DEFAULT_PROFILE.interactive_bin]
            else:
                command = args.session_command or ["bash"]
            if command and command[0] == DEFAULT_PROFILE.interactive_bin:
                return open_worker(worker_id, command, fresh=True, profile=DEFAULT_PROFILE)
            return open_worker(worker_id, command)
        elif args.command == start_name:
            config_dir, _ = paths()
            worker_id = resolve_open_worker(args.id, config_dir)
            return open_worker(
                worker_id, [DEFAULT_PROFILE.interactive_bin], fresh=True, profile=DEFAULT_PROFILE,
            )
        elif args.command == "pane-open":
            command = build_herdr_pane_open_command(args.placement, args.target_pane, args.direction)
            return subprocess.run(command, check=False).returncode
        elif args.command == "execute":
            if args.option_prompt is None:
                raise ValueError(
                    'Task prompt is required. Pass `execute --prompt "..."` '
                    "(or --prompt - to read stdin). "
                    f"`execute` is an alias of `hs {DEFAULT_PROFILE.name} --prompt`; "
                    "[execute] config is ignored."
                )
            return hs_agent(DEFAULT_PROFILE, [], prompt=args.option_prompt)
        elif args.command == "login":
            return login_agent(args.agent)
        elif args.command in AGENT_PROFILES:
            profile = AGENT_PROFILES[args.command]
            return hs_agent(profile, args.agent_args, prompt=args.prompt)
        else:
            errors = check(args.repo or context_repo(), args.execution)
            if errors:
                raise ValueError("Readiness checks failed:\n- " + "\n- ".join(errors))
            print("Sandbox setup is ready.")
    except (ValueError, OSError, tomllib.TOMLDecodeError) as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0



if __name__ == "__main__":
    sys.exit(main())
